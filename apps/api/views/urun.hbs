{{> bootstrap}}
<script>
(function () {
  const params = new URLSearchParams(window.location.search);
  const id = params.get("id") || "incir";
  const p = PRODUCTS.find((x) => x.id === id) || PRODUCTS[0];
  document.getElementById("pagetitle").textContent = "Bağdam — " + p.name;

  // urunler.html's tab panels use "cellar" for what products call the
  // "pantry" tab — everything else lines up 1:1. Fresh (box-only) items
  // have no tab panel of their own, so fall back to the default view.
  const TAB_TO_PANEL = { pantry: "cellar", dairy: "dairy", firin: "firin" };
  const backTab = TAB_TO_PANEL[p.tab];
  document.getElementById("crumbBack").href = backTab ? "urunler.html?tab=" + backTab : "urunler.html";

  const prefHtml = p.pref
    ? '<div class="pd-pref" data-pref-axis="' + p.pref.label + '">' +
      '<span class="pcard-pref-label mono">' + p.pref.label + "</span>" +
      '<div class="toggle-row">' +
      p.pref.options
        .map(
          (opt, i) =>
            '<button class="toggle' + (i === p.pref.def ? " active" : "") + '" type="button">' + opt + "</button>"
        )
        .join("") +
      "</div></div>"
    : "";

  const storage = p.fresh
    ? "Yıkayıp tüket. Serin yerde, tercihen buzdolabında sakla."
    : p.tab === "dairy"
      ? "Buzdolabında, +4°C altında sakla."
      : p.tab === "firin"
        ? "Oda sıcaklığında, kese kağıdında 2–3 gün tazeliğini korur; dilimleyip dondurabilirsin."
        : "Açılmadan serin ve kuru yerde, açıldıktan sonra buzdolabında sakla.";
  const allergen = p.tab === "dairy" ? "Süt" : "Yok";
  const batchRow = p.tab === "firin"
    ? '<div class="pd-usage-row"><span class="pd-usage-label mono">tazelik</span><span>Her sabah taze gelir.</span></div>'
    : p.id === "yumurta"
      ? '<div class="pd-usage-row"><span class="pd-usage-label mono">tazelik</span><span>Her sabah taze toplanır.</span></div>'
      : '<div class="pd-usage-row"><span class="pd-usage-label mono">parti numarası</span><span>' + p.batch + "</span></div>";

  const images = p.images && p.images.length > 0 ? p.images : [p.img];
  let imgIndex = 0;
  const navHtml = images.length > 1
    ? '<button class="pd-nav pd-nav-prev" type="button" aria-label="Önceki görsel">' +
        '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>' +
      "</button>" +
      '<button class="pd-nav pd-nav-next" type="button" aria-label="Sonraki görsel">' +
        '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>' +
      "</button>"
    : "";

  document.getElementById("detail").innerHTML =
    '<div class="pd-visual"><img id="pdImg" src="' + images[0] + '" alt="' + p.name + '">' + navHtml +
      '<img class="seal" src="assets/logo/logo-icon.svg" alt=""></div>' +
    '<div class="pd-body">' +
      // Mobilde üç sekme (ürün / detaylar / önerdiklerimiz); masaüstünde
      // sekme çubuğu gizli, üç grup eskisi gibi alt alta akar.
      '<div class="checkout-auth-tabs pd-tabs" id="pdTabs">' +
        '<button class="checkout-auth-tab active" type="button" data-pd-tab="main">ürün</button>' +
        '<button class="checkout-auth-tab" type="button" data-pd-tab="details">detaylar</button>' +
        '<button class="checkout-auth-tab" type="button" data-pd-tab="reco">önerdiklerimiz</button>' +
      "</div>" +
      '<div class="pd-tab-panel pd-tab-main" data-pd-panel="main">' +
        '<p class="pcard-meta mono">' + p.meta + "</p>" +
        "<h1>" + p.name + "</h1>" +
        '<p class="pd-desc">' + p.desc + "</p>" +
        prefHtml +
        '<div class="pd-price-row">' +
          '<span class="price">' + p.price + ' TL <span class="unit">/ ' + p.unit + "</span></span>" +
          (p.fresh
            ? '<a class="cta" href="urunler.html">kutuda dene</a>'
            : '<div class="qty-stepper-slot qty-stepper-slot-lg" data-add-to-cart="' + p.id + '"></div>') +
        "</div>" +
      "</div>" +
      '<div class="pd-tab-panel pd-tab-details" data-pd-panel="details">' +
        '<div class="pd-why">' +
          '<p class="pd-why-label mono">neden bunu seçtik</p>' +
          "<p>" + p.why + "</p>" +
        "</div>" +
        '<div class="pd-usage">' +
          '<div class="pd-usage-row"><span class="pd-usage-label mono">kullanım &amp; saklama</span><span>' + storage + "</span></div>" +
          '<div class="pd-usage-row"><span class="pd-usage-label mono">alerjen</span><span>' + allergen + "</span></div>" +
          batchRow +
        "</div>" +
      "</div>" +
      '<div class="pd-tab-panel pd-tab-reco" data-pd-panel="reco">' +
        '<div class="pd-reco">' +
          "<h2>senin için <em>önerdiklerimiz</em></h2>" +
          '<div id="reco"></div>' +
        "</div>" +
      "</div>" +
    "</div>";

  // cart.js already wires toggles/add-buttons on DOMContentLoaded, which fires
  // after this synchronous script finishes injecting #detail — no need to
  // call wireToggles/wireAddButtons again here (that would double-bind clicks).
  BahcedenCart.renderRecommended(document.getElementById("reco"), [p.id]);

  // Mobil sekmeler — masaüstünde çubuk gizli, paneller hep görünür (CSS).
  const pdTabs = document.getElementById("pdTabs");
  pdTabs.addEventListener("click", (e) => {
    const tab = e.target.closest("[data-pd-tab]");
    if (!tab) return;
    const key = tab.getAttribute("data-pd-tab");
    pdTabs.querySelectorAll("[data-pd-tab]").forEach((t) => t.classList.toggle("active", t === tab));
    document.querySelectorAll("[data-pd-panel]").forEach((pnl) => pnl.classList.toggle("pd-tab-active", pnl.getAttribute("data-pd-panel") === key));
  });
  document.querySelector('[data-pd-panel="main"]').classList.add("pd-tab-active");

  // Mobilde + / "kutuda dene" butonu ürün adının sağında durur (CSS absolute);
  // başlığın dikey ortasına hizalamak için gerçek konumu ölçülür.
  function alignPdButton() {
    const panel = document.querySelector(".pd-tab-main");
    const h1 = panel && panel.querySelector("h1");
    const btn = panel && (panel.querySelector(".qty-stepper-slot-lg") || panel.querySelector(".pd-price-row .cta"));
    if (!panel || !h1 || !btn) return;
    if (window.innerWidth > 900) { panel.style.removeProperty("--pd-btn-top"); return; }
    const pr = panel.getBoundingClientRect(), hr = h1.getBoundingClientRect();
    const top = hr.top - pr.top + hr.height / 2 - btn.offsetHeight / 2;
    panel.style.setProperty("--pd-btn-top", Math.max(0, Math.round(top)) + "px");
  }
  alignPdButton();
  window.addEventListener("resize", alignPdButton);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(alignPdButton);


  if (images.length > 1) {
    const pdImg = document.getElementById("pdImg");
    function showImage(i) {
      imgIndex = (i + images.length) % images.length;
      pdImg.src = images[imgIndex];
    }
    document.querySelector(".pd-nav-prev").addEventListener("click", () => showImage(imgIndex - 1));
    document.querySelector(".pd-nav-next").addEventListener("click", () => showImage(imgIndex + 1));
  }
})();
</script>

</body>
</html>
