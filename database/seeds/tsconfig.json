{
  "//": "Yalnız tip denetimi için: npx tsc -p database/seeds/tsconfig.json (çalıştırma tsx ile; kökte @types/node yok → apps/api'ninki kullanılır)",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["../../apps/api/node_modules/@types", "../../node_modules/@types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
