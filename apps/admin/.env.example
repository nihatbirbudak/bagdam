# apps/admin — yalnız geliştirme ortamı örneği (gerçek .env repoya girmez; ADR-0015)
# API tabanı. Dev'de Vite proxy'si /api -> API (:4010); üretimde nginx same-origin /api/.
VITE_API_URL=/api/v1
# F1 geçici kapı: true iken route guard atlanır (yalnız `vite` dev sunucusunda etkili; production build'de daima kapalı).
# F4'te AuthModule gelince bu satır kaldırılır.
VITE_AUTH_DISABLED=true
