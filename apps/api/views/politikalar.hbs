<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — politikalar</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<svg style="display:none" aria-hidden="true">
  <defs>
    <symbol id="ico-seal" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2"/>
      <text x="50" y="57" text-anchor="middle" font-family="Switzer" font-weight="700" font-size="30" fill="currentColor">BA</text>
    </symbol>
  </defs>
</svg>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html">blog</a>
      <a href="toptan.html">toptan</a>
      <a href="nasil-seciyoruz.html">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
</header>

<main>
  <section class="policies-layout">
    <nav class="policies-nav" aria-label="Politikalar">
      <p class="policies-nav-title mono">TÜM POLİTİKALAR</p>
      <div class="policies-nav-links">
{{#each legal}}
        <a href="#{{{slug}}}" data-policy="{{{slug}}}"{{#if @first}} class="active"{{/if}}>{{{title}}}</a>
{{/each}}
      </div>
    </nav>
    <div class="policies-body">
{{#each legalDocs}}
    <article class="policy" id="{{{slug}}}"{{#unless @first}} hidden{{/unless}}>
      <span class="eyebrow">Politikalar</span>
      <h1>{{{title}}}</h1>
      <p class="policy-updated mono">SON GÜNCELLEME: {{{updatedLabel}}}</p>
      <p class="policy-lead">{{{leadHtml}}}</p>
{{{bodyHtml}}}
    </article>
{{#unless @last}}

{{/unless}}
{{/each}}
    </div>
  </section>
</main>

{{> cookie_consent}}
{{> site_footer}}

{{> bootstrap}}
<script>
(function () {
  // Soldaki menüden seçilen politika sağda açılır; adres çubuğundaki #id
  // ile doğrudan bir politikaya gelinebilir (footer linkleri böyle gelir).
  const links = document.querySelectorAll(".policies-nav a[data-policy]");
  const articles = document.querySelectorAll(".policy");
  const strip = document.querySelector(".policies-nav-links");
  function show(id) {
    let found = false;
    articles.forEach((a) => { const on = a.id === id; a.hidden = !on; if (on) found = true; });
    if (!found) { articles.forEach((a, i) => { a.hidden = i !== 0; }); id = articles[0].id; }
    let active = null;
    links.forEach((l) => {
      const on = l.getAttribute("data-policy") === id;
      l.classList.toggle("active", on);
      if (on) active = l;
    });
    // Mobilde menü yatay şerit: aktif sekme ekran dışındaysa şeridi ona
    // kaydır (sayfayı dikey oynatmadan, sadece şeridin kendi kaydırması).
    if (active && strip && strip.scrollWidth > strip.clientWidth + 1) {
      const left = active.offsetLeft - (strip.clientWidth - active.offsetWidth) / 2;
      strip.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
    }
  }
  links.forEach((l) => l.addEventListener("click", (e) => {
    e.preventDefault();
    const id = l.getAttribute("data-policy");
    history.replaceState(null, "", "#" + id);
    show(id);
    // Yapışkan header'ın altına denk gelsin diye header yüksekliği düşülür.
    const head = document.querySelector(".nav");
    const offset = (head ? head.offsetHeight : 0) + 16;
    window.scrollTo({ top: document.querySelector(".policies-layout").offsetTop - offset, behavior: "smooth" });
  }));
  window.addEventListener("hashchange", () => show(location.hash.slice(1)));
  show(location.hash.slice(1));
})();
</script>

</body>
</html>
