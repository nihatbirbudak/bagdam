# ──────────────────────────────────────────────────────────────────────────────
# Bağdam — örnek ortam değişkenleri (ADR-0011 / ADR-0015)
# Kopyala: `cp .env.example .env` (kök) ya da `apps/api/.env`. Gerçek .env asla
# commit edilmez; prod/staging değerleri yalnız sunucuda (600). Sır yok: CHANGE_ME.
# apps/api önce apps/api/.env, sonra kök .env dosyasını okur.
# ──────────────────────────────────────────────────────────────────────────────

# ── Çalışma ortamı ────────────────────────────────────────────────────────────
# Ortam: development | test | production (production'da zorunlu env'ler fail-fast doğrulanır)
NODE_ENV=development
# API'nin dinlediği port (lokal 4010; prod/staging portları ecosystem.config.js'te)
PORT=4010
# Dinlenen adres — nginx arkasında yalnız loopback (ADR-0001)
HOST=127.0.0.1
# Saat dilimi — tüm kesim/tarih hesapları Europe/Istanbul (ADR-0004)
TZ=Europe/Istanbul
# Site modu: full (tam site) | coming-soon (apex lansmana kadar yalnız coming-soon sayfası — ADR-0012)
SITE_MODE=full

# ── Veritabanı (ADR-0011: lokal PG 14, migrate dev yalnız lokal) ──────────────
# PostgreSQL bağlantısı — lokal bagdam_dev; connection_limit=5 (ADR-0001)
DATABASE_URL="postgresql://bagdam:CHANGE_ME@localhost:5432/bagdam_dev?connection_limit=5&pool_timeout=20"

# ── Kimlik / şifreleme (ADR-0009) — üret: `openssl rand -base64 48` ────────────
# Access JWT imza anahtarı (15 dk) — en az 32 karakter
JWT_SECRET=CHANGE_ME_min_32_karakter_rastgele_deger
# Refresh JWT imza anahtarı (30 gün, rotasyon) — en az 32 karakter
JWT_REFRESH_SECRET=CHANGE_ME_min_32_karakter_rastgele_deger
# Setting tablosundaki sırların AES-256-GCM anahtarı — en az 32 karakter
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_min_32_karakter_rastgele_deger

# ── URL'ler (CORS allow-list) ─────────────────────────────────────────────────
# Web (müşteri) sitesi URL'i — lokal: API'nin kendisi (hbs sayfaları)
WEB_URL=http://localhost:4010
# Admin SPA URL'i — lokal Vite dev sunucusu
ADMIN_URL=http://localhost:4011

# ── Zamanlanmış işler ─────────────────────────────────────────────────────────
# Cron job'lar (delivery-dates, cycles, reminders, purge) — staging'de false (ADR-0011)
ENABLE_CRON=true

# ── E-posta (F6) ──────────────────────────────────────────────────────────────
# true → hiç e-posta gönderme, yalnız MailLog'a yaz (lokal/staging)
DISABLE_MAIL=true
# SMTP sunucusu (sağlayıcı kararı F0: Resend / SES) — boş bırakılabilir, Setting'den de okunur
SMTP_HOST=
# SMTP portu (587 STARTTLS / 465 SSL)
SMTP_PORT=
# SMTP kullanıcı adı
SMTP_USER=
# SMTP parolası
SMTP_PASS=
# Gönderen adresi (DKIM imzalı alan adından)
SMTP_FROM=

# ── Ödeme (F8) ────────────────────────────────────────────────────────────────
# Ödeme sağlayıcısı: manual (F7 geliştirme/test) | iyzico
PAYMENT_PROVIDER=manual
# iyzico API anahtarı (sandbox)
IYZICO_API_KEY=CHANGE_ME
# iyzico gizli anahtarı (sandbox)
IYZICO_SECRET_KEY=CHANGE_ME
# iyzico temel URL — sandbox; prod'da https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Seed (F2) ─────────────────────────────────────────────────────────────────
# İlk admin kullanıcısının e-postası (seed.ts env'den okur — ADR-0015)
SEED_ADMIN_EMAIL=admin@bagdam.com
# İlk admin parolası — yalnız lokal; prod'da ilk girişte değiştirilir
SEED_ADMIN_PASSWORD=CHANGE_ME

# ── Dosyalar (F4) ─────────────────────────────────────────────────────────────
# Yüklenen medya dizini (apps/api'ye göre; gitignore'lu)
UPLOADS_DIR=./uploads

# ── apps/admin (Vite; yalnız VITE_ önekli değişkenler bundle'a girer) ─────────
# Admin'in çağırdığı API kökü — same-origin proxy ile göreli
VITE_API_URL=/api/v1
