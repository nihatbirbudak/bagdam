<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — nasıl seçiyoruz</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<svg style="display:none" aria-hidden="true">
  <defs>
    <symbol id="ico-seal" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2"/>
      <text x="50" y="57" text-anchor="middle" font-family="Switzer" font-weight="700" font-size="30" fill="currentColor">BA</text>
    </symbol>
  </defs>
</svg>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html">blog</a>
      <a href="toptan.html">toptan</a>
      <a href="nasil-seciyoruz.html" class="on">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
</header>

<main>

  <!-- MANIFESTO HERO -->
  <section class="manifesto">
    <span class="eyebrow">{{{site.manifesto.hero.eyebrow}}}</span>
    <h1 class="manifesto-title">{{{site.manifesto.hero.title}}}</h1>
    <p class="manifesto-sub">{{{site.manifesto.hero.sub}}}</p>
    <p class="manifesto-rule mono">{{{site.manifesto.hero.rule}}}</p>
  </section>

  <!-- COMPARISON -->
  <section class="compare">
    <h2>{{{site.manifesto.compare.title}}}</h2>
    <div class="compare-grid">
      <div class="compare-col">
        <h3>{{{site.manifesto.compare.col1Title}}}</h3>
        <ul>
{{#each site.manifesto.compare.col1Items}}
          <li><span class="compare-label mono">{{{label}}}</span>{{{text}}}</li>
{{/each}}
        </ul>
      </div>
      <div class="compare-col">
        <h3>{{{site.manifesto.compare.col2Title}}}</h3>
        <ul>
{{#each site.manifesto.compare.col2Items}}
          <li><span class="compare-label mono">{{{label}}}</span>{{{text}}}</li>
{{/each}}
        </ul>
      </div>
      <div class="compare-col compare-col-active">
        <h3>{{{site.manifesto.compare.col3Title}}}</h3>
        <ul>
{{#each site.manifesto.compare.col3Items}}
          <li><span class="compare-label mono">{{{label}}}</span>{{{text}}}</li>
{{/each}}
        </ul>
      </div>
    </div>
    <p class="swipe-hint mono" aria-hidden="true">{{{site.manifesto.compare.swipeHint}}} <span class="swipe-arrow">→</span></p>
  </section>

{{!-- SİSTEM ADIMLARI: metinler site.manifesto.steps.items; görsel kartlar sabit — 1. adım olgunluk kartı (RIPENESS DEMO), diğerleri küratör kartı (VISIBLE CURATOR) --}}
{{#each site.manifesto.steps.items}}
{{#if @first}}  <!-- RIPENESS DEMO -->{{else}}  <!-- VISIBLE CURATOR -->{{/if}}
  <section class="demo-split">
    <div class="demo-text">
      <span class="eyebrow">{{{eyebrow}}}</span>
      <h2>{{{title}}}</h2>
      <p>{{{text}}}</p>
    </div>
    <div class="demo-visual">
{{#if @first}}
      <div class="demo-card">
        <p class="demo-label">{{{@root.site.manifesto.demo.ripenessLabel}}}</p>
        <div class="toggle-row">
          <div class="toggle">{{{@root.site.manifesto.demo.ripenessOption1}}}</div>
          <div class="toggle active">{{{@root.site.manifesto.demo.ripenessOption2}}}</div>
        </div>
        <p class="demo-note mono">{{{@root.site.manifesto.demo.ripenessNote}}}</p>
      </div>
{{else}}
      <div class="demo-card curator-card">
        <div class="avatar mono">{{{@root.site.manifesto.demo.curatorInitial}}}</div>
        <div>
          <p class="demo-label" style="margin:0;">{{{@root.site.manifesto.demo.curatorLabel}}}</p>
          <p class="curator-name">{{{@root.site.manifesto.demo.curatorName}}}</p>
        </div>
      </div>
{{/if}}
    </div>
  </section>
{{#unless @last}}

{{/unless}}
{{/each}}

  <!-- GUARANTEE -->
  <section class="guarantee">
    <img class="guarantee-seal" src="assets/logo/logo-icon.svg" alt="">
    <h2>{{{site.manifesto.guarantee.title}}}</h2>
    <p>{{{site.manifesto.guarantee.text}}}</p>
  </section>

  <!-- CLOSE -->
  <section class="manifesto-close">
    <h2>{{{site.manifesto.close.title}}}</h2>
    <a class="btn" href="{{{site.manifesto.close.ctaHref}}}">{{{site.manifesto.close.ctaText}}}</a>
  </section>

</main>

{{> site_footer}}

{{> bootstrap}}
</body>
</html>
