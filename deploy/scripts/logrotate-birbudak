# =============================================================================
# birbudak.com — ortak ops log rotasyonu
#
#   Kopyala:  /etc/logrotate.d/birbudak    (chmod 644; test: logrotate -d /etc/logrotate.d/birbudak)
#
#   Kapsam ve NEDEN yalnız bunlar:
#   - nginx logları (/var/log/nginx/*.log, Bağdam'ın bagdam.access.log / bagdam.error.log dahil)
#     zaten /etc/logrotate.d/nginx ile günlük döner, 14 gün tutulur (KVKK: access log 14 g ✓).
#     Aynı dosyayı ikinci kez tanımlamak logrotate "duplicate log entry" hatası verir → BURADA YOK.
#   - PM2 süreç logları (/opt/bagdam*/logs/api-*.log, /opt/uyanisakademi/logs/…) pm2-logrotate modülü
#     ile döner (günlük 00:00, 50M, 30 adet, gzip → ≈30 gün ✓). İki mekanizma çakışmasın diye BURADA YOK;
#     pm2-logrotate kaldırılırsa en alttaki yorumlu blok açılır.
#   - Burada: izleme/yedek betiklerinin /var/log/birbudak-*.log dosyaları (şu an hiç dönmüyor; error-watcher
#     logu MB'larca büyüdü) + deploy.sh'ın /opt/bagdam*/logs/deploy.log dosyaları.
# =============================================================================

/var/log/birbudak-*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 root adm
    dateext
}

/opt/bagdam/logs/deploy.log /opt/bagdam-staging/logs/deploy.log {
    monthly
    rotate 6
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 root root
}

# --- Yalnız pm2-logrotate modülü KALDIRILIRSA aç (pm2 uninstall pm2-logrotate) ---------------
