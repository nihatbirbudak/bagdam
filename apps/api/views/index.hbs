<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — Urla'dan sofrana</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<!-- ICON LIBRARY -->
<svg style="display:none" aria-hidden="true">
  <defs>
    <symbol id="ico-fig" viewBox="0 0 100 100">
      <ellipse cx="50" cy="52" rx="42" ry="40" fill="var(--surface-deep)"/>
      <ellipse cx="50" cy="52" rx="32" ry="30" fill="var(--fig)" opacity=".55"/>
      <ellipse cx="50" cy="52" rx="21" ry="20" fill="var(--fig-deep)"/>
      <g fill="var(--butter)">
        <circle cx="43" cy="45" r="1.6"/><circle cx="55" cy="41" r="1.5"/><circle cx="61" cy="50" r="1.6"/>
        <circle cx="58" cy="60" r="1.5"/><circle cx="47" cy="63" r="1.6"/><circle cx="39" cy="55" r="1.5"/>
        <circle cx="50" cy="52" r="1.6"/>
      </g>
    </symbol>
    <symbol id="ico-olive" viewBox="0 0 100 100">
      <path d="M20 70 Q45 30 82 26" stroke="var(--olive-deep)" stroke-width="2.5" fill="none"/>
      <ellipse cx="34" cy="55" rx="14" ry="17" fill="var(--olive)" transform="rotate(-18 34 55)"/>
      <ellipse cx="55" cy="42" rx="13" ry="16" fill="var(--olive-deep)" transform="rotate(-10 55 42)"/>
      <ellipse cx="74" cy="32" rx="12" ry="15" fill="var(--olive)" transform="rotate(-4 74 32)"/>
      <ellipse cx="30" cy="46" rx="10" ry="4" fill="var(--olive-deep)" transform="rotate(-30 30 46)"/>
      <ellipse cx="66" cy="24" rx="10" ry="4" fill="var(--olive-deep)" transform="rotate(-15 66 24)"/>
    </symbol>
    <symbol id="ico-egg" viewBox="0 0 100 100">
      <ellipse cx="35" cy="62" rx="20" ry="24" fill="var(--surface-deep)" transform="rotate(-8 35 62)"/>
      <ellipse cx="63" cy="58" rx="20" ry="25" fill="var(--butter-deep)" opacity=".35" transform="rotate(6 63 58)"/>
      <ellipse cx="50" cy="46" rx="21" ry="26" fill="var(--surface-deep)" transform="rotate(-2 50 46)"/>
      <ellipse cx="50" cy="46" rx="21" ry="26" fill="none" stroke="var(--ink)" stroke-opacity=".08" stroke-width="1" transform="rotate(-2 50 46)"/>
    </symbol>
    <symbol id="ico-melon" viewBox="0 0 100 100">
      <circle cx="50" cy="54" r="38" fill="var(--butter)"/>
      <g stroke="var(--butter-deep)" stroke-width="2" fill="none" opacity=".7">
        <path d="M50 16 Q30 54 50 92"/><path d="M50 16 Q70 54 50 92"/><path d="M50 16 Q50 54 50 92"/>
        <path d="M50 16 Q14 40 18 60"/><path d="M50 16 Q86 40 82 60"/>
      </g>
      <ellipse cx="50" cy="15" rx="4" ry="3" fill="var(--olive-deep)"/>
    </symbol>
    <symbol id="ico-walnut" viewBox="0 0 100 100">
      <path d="M50 12 C74 12 86 34 86 54 C86 78 70 90 50 90 C30 90 14 78 14 54 C14 34 26 12 50 12 Z" fill="var(--surface-deep)"/>
      <path d="M50 16 C48 30 52 40 44 50 C36 58 46 66 44 78" stroke="var(--fig-deep)" stroke-width="2.2" fill="none" opacity=".55"/>
      <path d="M50 16 C52 30 48 40 56 50 C64 58 54 66 56 78" stroke="var(--fig-deep)" stroke-width="2.2" fill="none" opacity=".55"/>
      <path d="M50 14 L50 90" stroke="var(--ink)" stroke-opacity=".12" stroke-width="1.5"/>
    </symbol>
    <symbol id="ico-grape" viewBox="0 0 100 100">
      <path d="M50 10 L50 24" stroke="var(--olive-deep)" stroke-width="2.5"/>
      <g fill="var(--fig)">
        <circle cx="50" cy="30" r="8"/>
        <circle cx="40" cy="42" r="8"/><circle cx="60" cy="42" r="8"/>
        <circle cx="32" cy="55" r="8"/><circle cx="50" cy="55" r="8"/><circle cx="68" cy="55" r="8"/>
        <circle cx="41" cy="68" r="8"/><circle cx="59" cy="68" r="8"/>
        <circle cx="50" cy="80" r="8"/>
      </g>
    </symbol>
    <symbol id="ico-tomato" viewBox="0 0 100 100">
      <circle cx="50" cy="56" r="34" fill="var(--tomato)"/>
      <ellipse cx="40" cy="46" rx="9" ry="6" fill="#fff" opacity=".18"/>
      <path d="M50 22 L44 30 L50 27 L56 30 Z" fill="var(--olive-deep)"/>
      <path d="M38 24 Q50 18 62 24" stroke="var(--olive-deep)" stroke-width="2.5" fill="none"/>
    </symbol>
    <symbol id="ico-chard" viewBox="0 0 100 100">
      <path d="M50 8 C22 20 16 56 30 90 C38 76 34 40 50 8 Z" fill="var(--olive)" opacity=".8"/>
      <path d="M50 8 C78 20 84 56 70 90 C62 76 66 40 50 8 Z" fill="var(--olive-deep)" opacity=".65"/>
      <path d="M50 10 L48 90" stroke="var(--tomato)" stroke-width="3" stroke-linecap="round"/>
    </symbol>
    <symbol id="ico-seal" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2"/>
      <text x="50" y="57" text-anchor="middle" font-family="Schibsted Grotesk" font-weight="700" font-size="30" fill="currentColor">BA</text>
    </symbol>
  </defs>
</svg>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html">blog</a>
      <a href="toptan.html">toptan</a>
      <a href="nasil-seciyoruz.html">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
{{> promo_bar}}
</header>


<main id="top">

  <!-- Mobilde hero üstünde kategori ikonları (ürünler sayfasındaki gibi);
       masaüstünde gizli — orada aynı ikonlar showcase içinde durur. -->
  <nav class="prod-tabs mobile-cat-tabs" aria-label="Kategoriler">
{{#each categories}}
    <a class="prod-tab" href="{{{href}}}"><img class="prod-tab-icon" src="{{{icon}}}" alt="">{{{label}}}</a>
{{/each}}
  </nav>

  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg" src="{{{site.home.hero.bgImage}}}" alt="" loading="eager">
    <img class="hero-icon" src="assets/logo/logo-icon.svg" alt="">
    <h1 class="hero-title">{{{site.home.hero.title}}}</h1>
    <p class="hero-sub">{{{site.home.hero.sub}}}</p>
    <a class="btn" href="{{{site.home.hero.ctaHref}}}">{{{site.home.hero.ctaText}}}</a>
  </section>

  <!-- VALUE PILLARS -->
  <section class="pillars">
{{#each site.home.pillars.items}}
    <div class="pillar">
      <h3>{{{title}}}</h3>
      <p>{{{text}}}</p>
    </div>
{{/each}}
  </section>

  <!-- SEZON KUTUSU SHOWCASE -->
  <section class="showcase">
    <div class="showcase-img"><img src="{{{site.home.showcase.image}}}" alt="{{{site.home.showcase.imageAlt}}}" loading="lazy"></div>
    <div class="showcase-text">
      <span class="eyebrow">{{{site.home.showcase.eyebrow}}}</span>
      <h2>{{{site.home.showcase.title}}}</h2>
      <p>{{{site.home.showcase.text}}}</p>
      <a class="btn" href="{{{site.home.showcase.ctaHref}}}">{{{site.home.showcase.ctaText}}}</a>
    </div>
    <div class="showcase-products">
      <a class="showcase-products-title" href="urunler.html"><h3>{{{site.home.showcase.productsTitle}}}</h3></a>
      <div class="showcase-tabs">
{{#each categories}}
        <a class="prod-tab" href="{{{href}}}"><img class="prod-tab-icon" src="{{{icon}}}" alt="">{{{label}}}</a>
{{/each}}
      </div>
    </div>
  </section>

  <!-- CATEGORY CLOUD -->
  <section class="cloud">
{{#each site.home.cloud.lines}}
    <p class="cloud-line">{{{html}}}</p>
{{/each}}
    <a class="btn" href="{{{site.home.cloud.ctaHref}}}">{{{site.home.cloud.ctaText}}}</a>
  </section>

  <!-- BEST OFFERS -->
  <section class="offers">
    <div class="offers-head">
      <h2>{{{site.home.blocks.offersTitle}}}</h2>
      <p>{{{site.home.blocks.offersText}}}</p>
    </div>
    <div class="pcard-grid offers-grid">
{{#each featured}}
{{#if product}}
{{> featured_product product}}
{{else}}
{{> featured_tier tier}}
{{/if}}
{{/each}}
    </div>
    <a class="showcase-row offers-more" href="urunler.html">{{{site.home.blocks.offersMoreText}}} <span class="showcase-arrow">↗</span></a>
  </section>

  <!-- JOURNAL TEASER -->
  <section class="journal-teaser">
    <div class="journal-teaser-head">
      <span class="eyebrow">{{{site.home.blocks.journalEyebrow}}}</span>
      <h2>{{{site.home.blocks.journalTitle}}}</h2>
      <a class="btn" href="{{{site.home.blocks.journalCtaHref}}}">{{{site.home.blocks.journalCtaText}}}</a>
    </div>
    <div class="journal-grid">
{{#each posts}}
      <a class="journal-card" href="gunluk.html#{{{slug}}}">
        <span class="journal-tag mono">{{{tag}}}</span>
        <h3>{{{titleText}}}</h3>
      </a>
{{/each}}
    </div>
    <p class="swipe-hint mono" aria-hidden="true">{{{site.home.blocks.swipeHint}}} <span class="swipe-arrow">→</span></p>
  </section>

  <!-- TWO BLOCKS -->
  <section class="blocks" id="hikaye">
    <div class="block block-solid">
      <span class="eyebrow block-eyebrow">{{{site.home.blocks.solidEyebrow}}}</span>
      <h2 class="block-heading">{{{site.home.blocks.solidTitle}}}</h2>
      <p class="block-text">{{{site.home.blocks.solidText}}}</p>
      <a class="btn-pill" href="{{{site.home.blocks.solidCtaHref}}}">{{{site.home.blocks.solidCtaText}}}</a>
    </div>
    <div class="block block-illust">
      <img src="{{{site.home.blocks.illustImage}}}" alt="{{{site.home.blocks.illustImageAlt}}}" loading="lazy">
      <a class="btn-pill" href="{{{site.home.blocks.illustCtaHref}}}">{{{site.home.blocks.illustCtaText}}}</a>
    </div>
  </section>

  <!-- FOOTER ACCORDION -->
  <section class="faq-row" id="faq">
    <div class="toptan-crate" aria-hidden="true">
      <div class="toptan-crate-inner">
        <!-- Fall + final stacking order both follow assets/icons/toptan-icon.png's
             reference composition. Two of each item: a smaller back layer falls
             first and settles more centered, a bigger front layer falls last
             and lands on top, spread wider but still inside the box's sides. -->
        <div class="toptan-crate-drop" style="--i:0; --dx:-46px; --dy:-19px; --rot:-6deg; --w:81px;">
          <img src="assets/icons/crate-watermelon.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:1; --dx:-25px; --dy:-7px; --rot:-10deg; --w:70px;">
          <img src="assets/icons/crate-pepper.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:2; --dx:35px; --dy:-39px; --rot:8deg; --w:81px;">
          <img src="assets/icons/crate-pumpkin.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:3; --dx:50px; --dy:-12px; --rot:12deg; --w:57px;">
          <img src="assets/icons/crate-spinach.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:4; --dx:-4px; --dy:-49px; --rot:9deg; --w:50px;">
          <img src="assets/icons/crate-carrot.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:5; --dx:15px; --dy:-60px; --rot:-8deg; --w:52px;">
          <img src="assets/icons/crate-beetroot.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:6; --dx:-50px; --dy:-30px; --rot:8deg; --w:81px;">
          <img src="assets/icons/crate-watermelon.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:7; --dx:-50px; --dy:-13px; --rot:10deg; --w:70px;">
          <img src="assets/icons/crate-pepper.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:8; --dx:15px; --dy:-70px; --rot:-6deg; --w:81px;">
          <img src="assets/icons/crate-pumpkin.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:9; --dx:65px; --dy:-25px; --rot:-9deg; --w:57px;">
          <img src="assets/icons/crate-spinach.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:10; --dx:-24px; --dy:-81px; --rot:-11deg; --w:50px;">
          <img src="assets/icons/crate-carrot.png" alt="">
        </div>
        <div class="toptan-crate-drop" style="--i:11; --dx:61px; --dy:-96px; --rot:6deg; --w:52px;">
          <img src="assets/icons/crate-beetroot.png" alt="">
        </div>
        <img class="toptan-crate-box" src="assets/icons/crate-box.png" alt="Toptan kasası">
      </div>
    </div>
    <div class="faq">
{{#each site.home.faq.items}}
      <details>
        <summary>{{{q}}}</summary>
        <p>{{{a}}}</p>
      </details>
{{/each}}
    </div>
  </section>

</main>

{{> cookie_consent}}
{{> site_footer}}

{{> bootstrap}}
<script>
(function () {
  var crate = document.querySelector(".toptan-crate");
  if (!crate || typeof IntersectionObserver === "undefined") return;
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        crate.classList.add("in-view");
        observer.disconnect();
      }
    });
  }, { threshold: 0.35 });
  observer.observe(crate);
})();

(function () {
  // "hikayemiz" sits alone in its block so it centers wherever the flex
  // math lands it — "haberdar ol" sits under a stack of copy in the block
  // next to it. Rather than guess a fixed offset (the copy's rendered
  // height isn't fixed across font loads/viewports), measure the real gap
  // on load/resize and push the lone button down to match.
  var solidBtn = document.querySelector(".block-solid .btn-pill");
  var illustBlock = document.querySelector(".block-illust");
  var illustBtn = illustBlock ? illustBlock.querySelector(".btn-pill") : null;
  if (!solidBtn || !illustBlock || !illustBtn) return;
  function alignBlockButtons() {
    illustBtn.style.marginBottom = "0px";
    // Mobilde bloklar alt alta (≤700px) — yan yana hizalama anlamsız, üstelik
    // fark yüzlerce px olup butonu resmin dışına iter. CSS alt-orta konumu yeter.
    if (window.innerWidth <= 900) return;
    var solidRect = solidBtn.getBoundingClientRect();
    var illustRect = illustBlock.getBoundingClientRect();
    var gap = illustRect.bottom - solidRect.bottom;
    illustBtn.style.marginBottom = Math.max(0, gap) + "px";
  }
  alignBlockButtons();
  window.addEventListener("resize", alignBlockButtons);
})();
</script>
</body>
</html>
