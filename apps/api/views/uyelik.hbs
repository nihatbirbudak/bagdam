<!-- F9 CMS — abonelik durum metinleri (SiteContent `uyelik.texts`; C ekler). <template> hiçbir zaman
     RENDER EDİLMEZ (piksel parite etkilenmez) ve dataset okuması HTML varlıklarını çözer; SiteContent
     değerleri sunucuda escapeHtml'lidir, bu yüzden üç süslü parantezli (ham) yazım kullanılır. Anahtar yoksa değer boş
     kalır ve cart.js/sayfa kendi Türkçe varsayılanına düşer. -->
<template id="uyelikTexts"
  data-empty="{{{site.uyelik.texts.empty}}}"
  data-empty-draft-cta="{{{site.uyelik.texts.emptyDraftCta}}}"
  data-empty-cta="{{{site.uyelik.texts.emptyCta}}}"
  data-loading="{{{site.uyelik.texts.loading}}}"
  data-load-error="{{{site.uyelik.texts.loadError}}}"
  data-pay-note="{{{site.uyelik.texts.payNote}}}"
  data-locked-note="{{{site.uyelik.texts.lockedNote}}}"
  data-skip-confirm="{{{site.uyelik.texts.skipConfirm}}}"
  data-skip-yes="{{{site.uyelik.texts.skipYes}}}"
  data-skip-no="{{{site.uyelik.texts.skipNo}}}"
  data-skip-label="{{{site.uyelik.texts.skipLabel}}}"
  data-unskip-label="{{{site.uyelik.texts.unskipLabel}}}"
  data-skip-used-label="{{{site.uyelik.texts.skipUsedLabel}}}"
  data-skipped-badge="{{{site.uyelik.texts.skippedBadge}}}"
  data-extras-title="{{{site.uyelik.texts.extrasTitle}}}"
  data-edit-box-cta="{{{site.uyelik.texts.editBoxCta}}}"
  data-apply-label="{{{site.uyelik.texts.applyLabel}}}"
  data-discard-label="{{{site.uyelik.texts.discardLabel}}}"
  data-saved-note="{{{site.uyelik.texts.savedNote}}}"
  data-next-delivery-label="{{{site.uyelik.texts.nextDeliveryLabel}}}"
  data-cutoff-label="{{{site.uyelik.texts.cutoffLabel}}}"
  data-past-due-badge="{{{site.uyelik.texts.pastDueBadge}}}"
  data-past-due-note="{{{site.uyelik.texts.pastDueNote}}}"
  data-past-due-action="{{{site.uyelik.texts.pastDueAction}}}"
  data-awaiting-badge="{{{site.uyelik.texts.awaitingBadge}}}"
  data-awaiting-note="{{{site.uyelik.texts.awaitingNote}}}"
  data-awaiting-action="{{{site.uyelik.texts.awaitingAction}}}"
  data-unpaid-badge="{{{site.uyelik.texts.unpaidBadge}}}"
  data-unpaid-note="{{{site.uyelik.texts.unpaidNote}}}"
  data-cancel-badge="{{{site.uyelik.texts.cancelBadge}}}"
  data-cancel-note="{{{site.uyelik.texts.cancelNote}}}"
  data-cancel-effective-label="{{{site.uyelik.texts.cancelEffectiveLabel}}}"
  data-cancel-abandon="{{{site.uyelik.texts.cancelAbandon}}}"
  data-completed-badge="{{{site.uyelik.texts.completedBadge}}}"
  data-completed-note="{{{site.uyelik.texts.completedNote}}}"
  data-completed-cta="{{{site.uyelik.texts.completedCta}}}"
  data-cancel-link="{{{site.uyelik.texts.cancelLink}}}"
  data-cancel-flow-title="{{{site.uyelik.texts.cancelFlowTitle}}}"
  data-cancel-flow-intro="{{{site.uyelik.texts.cancelFlowIntro}}}"
  data-cancel-flow-placeholder="{{{site.uyelik.texts.cancelFlowPlaceholder}}}"
  data-cancel-submit="{{{site.uyelik.texts.cancelSubmit}}}"
  data-cancel-confirm-submit="{{{site.uyelik.texts.cancelConfirmSubmit}}}"
  data-cancel-back="{{{site.uyelik.texts.cancelBack}}}"
  data-retention-offer="{{{site.uyelik.texts.retentionOffer}}}"
  data-retention-offer-plain="{{{site.uyelik.texts.retentionOfferPlain}}}"
  data-retention-accept="{{{site.uyelik.texts.retentionAccept}}}"
  data-retention-applied="{{{site.uyelik.texts.retentionApplied}}}"
  data-busy-note="{{{site.uyelik.texts.busyNote}}}"
  data-generic-error="{{{site.uyelik.texts.genericError}}}"></template>

{{> bootstrap}}
<script>
(function () {
  function money(n) { return n.toLocaleString("tr-TR"); }

  const logoutNote = document.getElementById("logoutNote");
  // F6 auth: ?dogrulandi=1 (e-posta doğrulama dönüşü) ve yenileme sonrası kısa bilgi notu (sessionStorage flash).
  const authInfo = document.getElementById("authInfo");
  (function showAuthInfo() {
    let text = "";
    try {
      const qs = new URLSearchParams(location.search);
      if (qs.get("dogrulandi") === "1") {
        text = "E-posta adresin doğrulandı — teşekkürler.";
        qs.delete("dogrulandi");
        const rest = qs.toString();
        history.replaceState(null, "", location.pathname + (rest ? "?" + rest : "") + location.hash);
      }
      const flash = sessionStorage.getItem("bagdam_flash");
      if (flash) { sessionStorage.removeItem("bagdam_flash"); text = text ? text + " " + flash : flash; }
    } catch (e) { /* eski tarayıcıda sessizce geç */ }
    if (text && authInfo) { authInfo.textContent = text; authInfo.hidden = false; }
  })();
  // Kartlar aşağıda tanımlanır; auth değişince hepsini tazeleyen fonksiyon
  // sayfa kurulumu bitince atanır (ilk kurulum çağrısında henüz yoktur).
  let onAuthChange = null;
  BahcedenCart.wireAuthGate("accountGrid", (loggedIn) => {
    logoutNote.hidden = !loggedIn;
    if (onAuthChange) onAuthChange();
  });

  const subCard = document.getElementById("subCard");

  // ---- Sağ sütun sekmeleri: teslimat adresi / ödeme yöntemi / önceki
  // siparişler — hangisine basılırsa yalnızca o panel görünür.
  const accountTabs = document.getElementById("accountTabs");
  const accountPanels = document.querySelectorAll(".account-panel");
  accountTabs.addEventListener("click", (e) => {
    const tab = e.target.closest(".checkout-auth-tab");
    if (!tab) return;
    const key = tab.getAttribute("data-panel");
    if (tab.classList.contains("active")) return;
    accountTabs.querySelectorAll(".checkout-auth-tab").forEach((t) => t.classList.toggle("active", t === tab));
    accountPanels.forEach((p) => { p.hidden = p.getAttribute("data-panel") !== key; });
    // Sekme değişince açık kalmış "düzenle" formları kapanır: kaydedilmemiş
    // girdiler atılır, adres/ödeme kayıtlı haliyle (özet olarak) geri gelir.
    // (renderAddress/renderPayment aşağıda tanımlı — tıklama anında var.)
    renderAddress();
    renderPayment();
  });

  // ---- F9 remote: abonelik kartı — SUNUCU tek doğruluk kaynağı (BahcedenCart.remote) ----
  // Satın alınmış abonelikte gün ve ekstra değişiklikleri önce yerel TASLAKTA birikir; "değişiklikleri onayla"
  // ile API'ye gider (PATCH /me/subscription · PATCH …/cycles/current) ve dönen DTO ile kart yeniden çizilir.
  // Atlama, iptal ve kalma teklifi kendi onaylarından geçip doğrudan API'ye gider. Optimistic güncelleme YOK:
  // ekranda görünen her zaman sunucudan dönen `BootstrapSub` DTO'sudur.
  // Durum dalları (ADR-0003 istisna 7 — aynı kart içinde ek metin/aksiyon):
  //   ACTIVE            → bu haftanın kutusu + kesim geri sayımı + atla/geri al + içerik düzenle + sonraki teslimat
  //   PAST_DUE          → dunning uyarısı + "kartını güncelle" (ödeme yöntemi sekmesi)
  //   CANCEL_REQUESTED  → iptal tarihi + vazgeç (+ sunucu teklif sunduysa kalma teklifi)
  //   AWAITING_PAYMENT  → ödeme linki butonu (cycle.paymentLinkUrl) · UNPAID → tahsilat uyarısı + kart güncelle
  //   COMPLETED         → tek seferlik kutu teslim edildi (PAUSED dalı yok — ADR-0008: şema-var/UI-yok)
  const SUB_TEXT_DEFAULTS = {
    empty: "Henüz bir aboneliğin yok.",
    emptyDraftCta: "kutunu tamamla",
    emptyCta: "kutunu oluştur",
    loading: "Aboneliğin yükleniyor…",
    loadError: "Aboneliğin yüklenemedi — sayfayı yenileyip tekrar dene.",
    payNote: "Ödemen teslimat günü çekilir — ekstralar kutu ücretiyle birlikte tahsil edilir ve kutunla aynı gün teslim edilir. Sonraki hafta kutun ekstrasız yenilenir.",
    lockedNote: "Bu haftanın değişiklik süresi doldu",
    skipConfirm: "Bu haftaki kutunu atlamak istediğine emin misin?",
    skipYes: "atla",
    skipNo: "vazgeç",
    skipLabel: "bir sonraki siparişi atla",
    unskipLabel: "atlamayı iptal et",
    skipUsedLabel: "atlama hakkın kullanıldı",
    skippedBadge: "BİR SONRAKİ SİPARİŞ ATLANDI",
    extrasTitle: "BU HAFTAKİ EKSTRALAR",
    editBoxCta: "kutunu düzenle + ekstra ekle",
    applyLabel: "değişiklikleri onayla",
    discardLabel: "vazgeç",
    savedNote: "Değişikliklerin kaydedildi.",
    nextDeliveryLabel: "Sonraki teslimat",
    cutoffLabel: "DEĞİŞİKLİK İÇİN",
    pastDueBadge: "ÖDEME ALINAMADI",
    pastDueNote: "Bu haftanın ödemesini kartından çekemedik. Kartını güncellersen bir sonraki denemede otomatik olarak tahsil edilir.",
    pastDueAction: "kartını güncelle",
    awaitingBadge: "ÖDEME BEKLİYOR",
    awaitingNote: "Bu haftaki kutunun ödemesi bekleniyor — güvenli ödeme sayfasından tamamlayabilirsin.",
    awaitingAction: "ödemeyi tamamla",
    unpaidBadge: "ÖDEME ALINAMADI",
    unpaidNote: "Bu haftaki kutunun ödemesi alınamadı — kartını güncelleyip yeniden deneyebiliriz.",
    cancelBadge: "İPTAL TALEBİN ALINDI",
    cancelNote: "Aboneliğin sona erecek; o tarihe kadar kalan kutuların teslim edilir.",
    cancelEffectiveLabel: "Sona erme tarihi",
    cancelAbandon: "iptalden vazgeç",
    completedBadge: "TESLİM EDİLDİ",
    completedNote: "Tek seferlik kutun teslim edildi — dilediğin zaman yeni bir kutu oluşturabilirsin.",
    completedCta: "yeni kutu oluştur",
    cancelLink: "aboneliği iptal et",
    cancelFlowTitle: "Gittiğine üzüldük.",
    cancelFlowIntro: "Neden ayrıldığını bize söylemek ister misin? İstersen boş bırakabilirsin.",
    cancelFlowPlaceholder: "Bize kısaca yazabilirsin…",
    cancelSubmit: "aboneliği iptal et",
    cancelConfirmSubmit: "yine de aboneliği iptal et",
    cancelBack: "vazgeç",
    retentionOffer: "<b>Gitmeden önce:</b> sana {boxes} kutuluk <b>%{pct} indirim</b> hakkı veriyoruz — kullanmak ister misin?",
    retentionOfferPlain: "<b>Gitmeden önce:</b> sana özel bir indirim hakkı tanımladık — kullanmak ister misin?",
    retentionAccept: "indirimi kullan, üye kal",
    retentionApplied: "1 kutuluk indirim (üye kaldığın için)",
    busyNote: "Kaydediliyor…",
    genericError: "İşlem tamamlanamadı — tekrar dene.",
  };
  // Metinler CMS'ten (SiteContent `uyelik.texts` → <template id="uyelikTexts" data-*>); anahtar yoksa/boşsa
  // yukarıdaki varsayılan kullanılır. Markup'taki sabit metinler değişmez → anonim görünüm paritesi korunur.
  const subTextsEl = document.getElementById("uyelikTexts");
  function T(key) {
    const raw = subTextsEl && subTextsEl.dataset ? subTextsEl.dataset[key] : "";
    return raw && String(raw).trim() ? String(raw) : SUB_TEXT_DEFAULTS[key];
  }
  function fill(text, vars) {
    return String(text).replace(/\{(\w+)\}/g, (m, k) => (vars && vars[k] !== undefined ? String(vars[k]) : m));
  }

  let subDraft = null;          // yerel taslak (gün / ekstra) — onaylanana dek sunucuya gitmez
  let skipConfirmOpen = false;
  let cancelFlowOpen = false;   // neden formu açık (talep henüz gönderilmedi)
  let cancelOffer = null;       // POST /cancel yanıtındaki teklif ({pct, boxes}) — kararı SUNUCU verir
  let subBusy = false;          // API isteği sürüyor → düğmeler pasif
  let subMsg = "";              // kart altındaki bilgi/hata notu
  let subMsgOk = false;
  let subLoadError = "";

  function ensureDraft() {
    if (!subDraft) subDraft = JSON.parse(JSON.stringify(BahcedenCart.getSub()));
    return subDraft;
  }
  function hasPending() {
    return !!subDraft && JSON.stringify(subDraft) !== JSON.stringify(BahcedenCart.getSub());
  }
  // F9 remote: canlı (satın alınmış + oturumlu) abonelik mi — mutasyonlar API'ye buna göre gider.
  function isServerSub() {
    return BahcedenCart.remote.isLive();
  }
  function setSubMsg(text, ok) {
    subMsg = text || "";
    subMsgOk = !!ok;
  }
  // Tek giriş noktası: istek boyunca kart pasif, hata mesajı kartın altında, başarıda taslak düşer.
  function runSub(task, okText) {
    if (subBusy) return Promise.resolve();
    subBusy = true;
    setSubMsg("");
    renderSub();
    return task().then(
      () => {
        subBusy = false;
        subDraft = null;
        skipConfirmOpen = false;
        cancelFlowOpen = false;
        cancelOffer = null;
        setSubMsg(okText || "", true);
        renderSub();
      },
      (err) => {
        subBusy = false;
        setSubMsg((err && err.message) || T("genericError"));
        renderSub();
      },
    );
  }

  function renderSub() {
    const saved = BahcedenCart.getSub();
    const live = isServerSub();

    if (!live) {
      // Satın alınmış abonelik yok: sepette bekleyen kutu taslağı varsa oraya, yoksa katalog yönlendirmesi.
      const draftTier = BahcedenCart.subTier();
      subCard.innerHTML =
        '<p class="pcard-meta mono">ABONELİK</p>' +
        '<p class="account-empty">' + escText(subLoadError || T("empty")) + "</p>" +
        (draftTier
          ? '<a class="cta" href="kutu.html?tier=' + escAttr(draftTier.id) + '">' + escText(T("emptyDraftCta")) + "</a>"
          : '<a class="cta" href="urunler.html">' + escText(T("emptyCta")) + "</a>");
      return;
    }

    const sub = subDraft || saved;
    const tier = BahcedenCart.subTier() || { id: saved.tierId || "", label: saved.tierId || "Kutun", note: "", price: 0, count: (saved.items || []).length, img: "" };
    const status = saved.status || "ACTIVE";
    const cycle = saved.currentCycle || null;
    const inFlight = saved.inFlightCycle || null;
    const completed = status === "COMPLETED";
    const cancelRequested = status === "CANCEL_REQUESTED";
    const openCancel = saved.cancellation && saved.cancellation.outcome === "PENDING" ? saved.cancellation : null;
    const awaiting = !!inFlight && inFlight.status === "AWAITING_PAYMENT";
    const unpaid = !!inFlight && inFlight.status === "UNPAID";
    const pastDue = status === "PAST_DUE" || (!!saved.dunning && saved.dunning.active && !awaiting);
    // Düzenlenebilirlik SUNUCUDAN: açık cycle var ve kesimi geçmemiş (cart.js kendi saat hesabını yapmaz).
    const editable = !completed && !!cycle && !cycle.locked;
    const isSub = !saved.isOneTime && sub.type === "subscription";

    const itemNames = (sub.items || [])
      .map((id) => { const p = PRODUCTS.find((x) => x.id === id); return p ? p.name : ""; })
      .filter(Boolean)
      .join(", ");

    // Taslak varken toplam da taslaktan hesaplanır — subExtrasTotal() kayıtlı hali okur, onaylanmamış
    // silmeleri görmez. Onaylanmış hâlde ise "Bu haftaki ödeme" satırı SUNUCUNUN cycle toplamıdır.
    const extras = sub.extras || [];
    const extrasTotal = extras.reduce((sum, ex) => sum + BahcedenCart.subExtraPrice(ex), 0);
    const hasRetentionDiscount = !!saved.nextBoxDiscount;
    const discountAmount = hasRetentionDiscount ? Math.round(tier.price / 2) : 0;
    const localWeekTotal = sub.skipThisWeek ? 0 : tier.price - discountAmount + extrasTotal;
    const serverTotal = cycle && cycle.total !== null && cycle.total !== undefined ? Number(cycle.total) : null;
    const weekTotal = !hasPending() && serverTotal !== null ? serverTotal : localWeekTotal;

    const cutoff = BahcedenCart.nextCutoff();
    const countdown = BahcedenCart.formatCountdown(cutoff);
    const freq = isSub ? FREQ_OPTIONS.find((f) => f.id === sub.freq) : null;
    const freqLabel = freq ? freq.label + (!freq.allDays && sub.deliveryDay ? " — " + (DELIVERY_DAYS.find((d) => d.id === sub.deliveryDay) || {}).label : "") : null;
    const nextDeliveryOn = saved.nextDeliveryOn || (cycle && cycle.deliveryOn) || (inFlight && inFlight.deliveryOn) || null;
    const nextDeliveryText = BahcedenCart.formatDeliveryDate(nextDeliveryOn);

    const skipLabel = sub.skipThisWeek ? T("unskipLabel") : (sub.skipUsed ? T("skipUsedLabel") : T("skipLabel"));
    // Atlanan hafta DTO'da `locked: true` gelir (durumu SCHEDULED değil) → kutu içeriği düzenlenemez;
    // ama atlamayı GERİ ALMAK kesime kadar mümkündür (sunucu DELETE …/skip'i kabul eder). Bu yüzden
    // geri alma düğmesi `editable` yerine yalnız kesim anına bakar.
    const cutoffPassed = !cycle || !cycle.cutoffAtIso || new Date(cycle.cutoffAtIso).getTime() <= BahcedenCart.serverNow();
    const skipDisabled = (!sub.skipThisWeek && sub.skipUsed) || (sub.skipThisWeek ? cutoffPassed : !editable) || subBusy;

    const TRASH_SVG =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';
    const extrasListHtml = extras.length
      ? '<div class="account-extras">' +
          '<p class="pcard-meta mono">' + escText(T("extrasTitle")) + "</p>" +
          extras.map((ex, i) => {
            const p = PRODUCTS.find((x) => x.id === ex.id);
            if (!p) return "";
            return (
              '<div class="account-extra-row">' +
                "<span>" + escText(p.name) + ' <span class="mono">(' + escText(ex.label) + ")</span></span>" +
                '<span class="mono">' + money(BahcedenCart.subExtraPrice(ex)) + " TL</span>" +
                (editable && !subBusy ? '<button class="qty-stepper-dec trash" data-extra-idx="' + i + '" type="button" aria-label="Ekstrayı kaldır">' + TRASH_SVG + "</button>" : "") +
              "</div>"
            );
          }).join("") +
        "</div>"
      : "";

    // Teslimat günü kutu sayfasına gitmeden buradan da değiştirilebilir (PATCH /me/subscription).
    // Kesimi geçmiş gün de seçilebilir — not, teslimatın sonraki haftaya kaldığını söyler.
    const dayNoteText = BahcedenCart.lockedDayNote(sub.deliveryDay);
    const dayToggleHtml = completed || cancelRequested
      ? ""
      : '<div class="freq-row account-day-row">' +
          '<span class="pcard-pref-label mono">teslimat günü</span>' +
          '<div class="toggle-list small" id="accountDayToggle">' +
            DELIVERY_DAYS.map((d) => {
              const isActive = sub.deliveryDay === d.id;
              return '<button class="toggle' + (isActive ? " active" : "") + '" type="button" data-day="' + escAttr(d.id) + '"' + (subBusy ? " disabled" : "") + ">" + escText(d.label) + "</button>";
            }).join("") +
          "</div>" +
          (dayNoteText ? '<p class="day-note mono">' + escText(dayNoteText) + "</p>" : "") +
        "</div>";

    // ---- Durum şeritleri (ADR-0003 istisna 7): ödeme bekliyor / tahsil edilemedi / iptal talebi / tamamlandı
    function banner(badge, note, actionsHtml) {
      // Kart içinde ek şerit — yeni CSS sınıfı YOK: mevcut .sub-skip-note / .account-empty / .account-actions
      // kalıpları kullanılır (ADR-0003 istisna 7: uyelik durum metinleri aynı kartın içinde).
      return (
        '<p class="sub-skip-note mono">' + escText(badge) + "</p>" +
        '<p class="account-empty">' + note + "</p>" +
        (actionsHtml ? '<div class="account-actions">' + actionsHtml + "</div>" : "")
      );
    }
    let statusHtml = "";
    if (completed) {
      statusHtml += banner(T("completedBadge"), escText(T("completedNote")), '<a class="cta" href="urunler.html">' + escText(T("completedCta")) + "</a>");
    }
    if (awaiting) {
      const due = inFlight.paymentDueAtIso ? " Son ödeme: " + orderDateParts(inFlight.paymentDueAtIso).date + "." : "";
      statusHtml += banner(
        T("awaitingBadge"),
        escText(T("awaitingNote") + due),
        inFlight.paymentLinkUrl
          ? '<a class="cta" href="' + escAttr(inFlight.paymentLinkUrl) + '" target="_blank" rel="noopener">' + escText(T("awaitingAction")) + "</a>"
          : "",
      );
    } else if (unpaid || pastDue) {
      const retryText = saved.dunning && saved.dunning.nextRetryAtIso
        ? " Bir sonraki deneme: " + orderDateParts(saved.dunning.nextRetryAtIso).date + " " + orderDateParts(saved.dunning.nextRetryAtIso).time + "."
        : "";
      statusHtml += banner(
        unpaid ? T("unpaidBadge") : T("pastDueBadge"),
        escText((unpaid ? T("unpaidNote") : T("pastDueNote")) + retryText),
        '<button class="cta" id="updateCardBtn" type="button">' + escText(T("pastDueAction")) + "</button>" +
          (inFlight && inFlight.paymentLinkUrl
            ? '<a class="btn" href="' + escAttr(inFlight.paymentLinkUrl) + '" target="_blank" rel="noopener">' + escText(T("awaitingAction")) + "</a>"
            : ""),
      );
    }
    if (cancelRequested || openCancel) {
      const eff = openCancel && openCancel.effectiveAtIso ? orderDateParts(openCancel.effectiveAtIso).date : null;
      const offerHtml = openCancel && openCancel.retentionOffered
        ? '<p class="cancel-offer">' + (cancelOffer ? fill(T("retentionOffer"), cancelOffer) : T("retentionOfferPlain")) + "</p>"
        : "";
      statusHtml += banner(
        T("cancelBadge"),
        escText(T("cancelNote") + (eff ? " " + T("cancelEffectiveLabel") + ": " + eff + "." : "")) + offerHtml,
        (openCancel && openCancel.retentionOffered ? '<button class="cta" id="useOfferBtn" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(T("retentionAccept")) + "</button>" : "") +
          '<button class="btn" id="confirmCancelBtn" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(openCancel && openCancel.retentionOffered ? T("cancelConfirmSubmit") : T("cancelSubmit")) + "</button>" +
          '<button class="btn" id="abandonCancelBtn" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(T("cancelAbandon")) + "</button>",
      );
    }

    // İptal akışı (talep henüz gönderilmedi): kısa ayrılma-nedeni formu; teklifi SUNUCU döndürür.
    const cancelFlowHtml =
      '<div class="cancel-flow">' +
        '<p class="cancel-flow-title">' + escText(T("cancelFlowTitle")) + "</p>" +
        '<p class="account-empty">' + escText(T("cancelFlowIntro")) + "</p>" +
        '<div class="toggle-list small" id="cancelReasons">' +
          BahcedenCart.CANCEL_REASONS.map((r) =>
            '<button class="toggle" type="button" data-reason="' + escAttr(r.value) + '">' + escText(r.label) + "</button>"
          ).join("") +
        "</div>" +
        '<textarea class="cancel-reason-text" id="cancelReasonText" placeholder="' + escAttr(T("cancelFlowPlaceholder")) + '"></textarea>' +
        '<div class="account-actions">' +
          '<button class="btn" id="requestCancelBtn" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(T("cancelSubmit")) + "</button>" +
        "</div>" +
        '<p class="cancel-note"><a href="#" id="cancelFlowBack">' + escText(T("cancelBack")) + "</a></p>" +
      "</div>";

    const skipConfirmHtml =
      '<div class="skip-confirm">' +
        "<span>" + escText(T("skipConfirm")) + "</span>" +
        '<button class="btn" id="skipYesBtn" type="button">' + escText(T("skipYes")) + "</button>" +
        '<button class="btn" id="skipNoBtn" type="button">' + escText(T("skipNo")) + "</button>" +
      "</div>";

    subCard.innerHTML =
      '<p class="pcard-meta mono">' + (completed ? "TAMAMLANAN SİPARİŞ" : isSub ? "AKTİF ABONELİK" : "TEK SEFERLİK SİPARİŞ") + "</p>" +
      "<h2>" + escText(tier.label) + "</h2>" +
      '<p class="pcard-meta mono">' + escText(itemNames) + "</p>" +
      statusHtml +
      extrasListHtml +
      (isSub && freqLabel ? '<p class="account-freq mono">Gönderim: ' + escText(freqLabel) + "</p>" : "") +
      (sub.skipThisWeek ? '<p class="sub-skip-note mono">' + escText(T("skippedBadge")) + "</p>" : "") +
      dayToggleHtml +
      (completed
        ? ""
        : '<div class="account-pay">' +
            '<div class="ps-row"><span>Kutu</span><span class="mono">' + money(sub.skipThisWeek ? 0 : tier.price) + " TL</span></div>" +
            (hasRetentionDiscount ? '<div class="ps-row ps-note"><span>' + escText(T("retentionApplied")) + '</span><span class="mono">-' + money(sub.skipThisWeek ? 0 : discountAmount) + " TL</span></div>" : "") +
            (extras.length ? '<div class="ps-row"><span>Bu haftaki ekstralar</span><span class="mono">+' + money(sub.skipThisWeek ? 0 : extrasTotal) + " TL</span></div>" : "") +
            '<div class="ps-row ps-total"><span>Bu haftaki ödeme</span><span class="mono">' + money(weekTotal) + " TL</span></div>" +
            (nextDeliveryText ? '<div class="ps-row ps-note"><span>' + escText(T("nextDeliveryLabel")) + '</span><span class="mono">' + escText(nextDeliveryText) + "</span></div>" : "") +
            '<p class="account-freq mono">' + escText(T("payNote")) + "</p>" +
          "</div>") +
      (completed
        ? ""
        : '<div class="pd-price-row">' +
            '<span class="cutoff mono">' + escText(T("cutoffLabel")) + ": " + countdown.toLocaleUpperCase("tr-TR") + " SÜREN VAR</span>" +
          "</div>") +
      (hasPending()
        ? '<div class="account-actions account-pending">' +
            '<button class="cta" id="applyAccountChanges" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(T("applyLabel")) + "</button>" +
            '<button class="btn" id="discardAccountChanges" type="button"' + (subBusy ? " disabled" : "") + ">" + escText(T("discardLabel")) + "</button>" +
          "</div>"
        : "") +
      (completed
        ? ""
        : '<div class="account-actions">' +
            (editable
              ? '<a class="cta olive" href="kutu.html?tier=' + escAttr(tier.id) + '">' + escText(T("editBoxCta")) + "</a>"
              : '<span class="account-locked mono">' + escText(T("lockedNote")) + "</span>") +
            (isSub && !skipConfirmOpen && !cancelRequested ? '<button class="btn" type="button" id="skipWeekBtn"' + (skipDisabled ? " disabled" : "") + ">" + escText(skipLabel) + "</button>" : "") +
          "</div>") +
      (skipConfirmOpen ? skipConfirmHtml : "") +
      (subMsg ? '<p class="checkout-auth-msg mono" id="subMsg"' + (subMsgOk ? ' style="color:var(--olive-deep)"' : "") + ">" + escText(subMsg) + "</p>" : "") +
      (subBusy ? '<p class="cancel-note mono">' + escText(T("busyNote")) + "</p>" : "") +
      (completed || cancelRequested || openCancel
        ? ""
        : cancelFlowOpen
          ? cancelFlowHtml
          : '<p class="cancel-note"><a href="#" id="cancelSubLink">' + escText(T("cancelLink")) + "</a></p>");

    wireSubCard();
  }

  // ---- Kart içindeki düğmeler: taslak (gün/ekstra) yerelde birikir, gerisi doğrudan API'ye gider ----
  function wireSubCard() {
    // Ekstra silme ve gün değişikliği taslağa yazılır — onay bekler.
    subCard.querySelectorAll("[data-extra-idx]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const d = ensureDraft();
        const idx = parseInt(btn.getAttribute("data-extra-idx"), 10);
        d.extras = (d.extras || []).filter((_, i2) => i2 !== idx);
        setSubMsg("");
        renderSub();
      });
    });

    const dayToggle = document.getElementById("accountDayToggle");
    if (dayToggle) {
      dayToggle.querySelectorAll(".toggle:not([disabled])").forEach((btn) => {
        btn.addEventListener("click", () => {
          ensureDraft().deliveryDay = btn.getAttribute("data-day");
          setSubMsg("");
          renderSub();
        });
      });
    }

    // F9 remote: onay → önce abonelik alanları (gün; SCHEDULED cycle'ları yeniden üretir), sonra kutu içeriği.
    const applyBtn = document.getElementById("applyAccountChanges");
    if (applyBtn) {
      applyBtn.addEventListener("click", () => {
        const draft = subDraft;
        const saved = BahcedenCart.getSub();
        if (!draft) return;
        const steps = [];
        if (draft.deliveryDay && draft.deliveryDay !== saved.deliveryDay) {
          steps.push(() => BahcedenCart.remote.patchSubscription({ deliveryDay: draft.deliveryDay }));
        }
        if (draft.freq && draft.freq !== saved.freq) {
          steps.push(() => BahcedenCart.remote.patchSubscription({ freq: draft.freq }));
        }
        if (JSON.stringify(draft.extras || []) !== JSON.stringify(saved.extras || [])) {
          steps.push(() =>
            BahcedenCart.remote.patchCycle({
              extras: (draft.extras || []).map((ex) => ({ id: ex.id, factor: ex.factor, label: ex.label || "" })),
            }),
          );
        }
        if (!steps.length) { subDraft = null; renderSub(); return; }
        runSub(() => steps.reduce((p, step) => p.then(step), Promise.resolve()), T("savedNote"));
      });
      document.getElementById("discardAccountChanges").addEventListener("click", () => {
        subDraft = null;
        setSubMsg("");
        renderSub();
      });
    }

    // Atlama: geri almak güvenli (soru yok), atlamak onay sorusundan geçer — ikisi de doğrudan API'ye.
    const skipWeekBtn = document.getElementById("skipWeekBtn");
    if (skipWeekBtn) {
      skipWeekBtn.addEventListener("click", () => {
        if (BahcedenCart.getSub().skipThisWeek) {
          runSub(() => BahcedenCart.remote.unskip(), "Atlama geri alındı.");
          return;
        }
        skipConfirmOpen = true;
        renderSub();
      });
    }
    const skipYesBtn = document.getElementById("skipYesBtn");
    if (skipYesBtn) {
      skipYesBtn.addEventListener("click", () => runSub(() => BahcedenCart.remote.skip(), "Bu haftaki kutun atlandı."));
      document.getElementById("skipNoBtn").addEventListener("click", () => {
        skipConfirmOpen = false;
        renderSub();
      });
    }

    // PAST_DUE / UNPAID: "kartını güncelle" → ödeme yöntemi sekmesi (yeni kart ekleme akışı orada).
    const updateCardBtn = document.getElementById("updateCardBtn");
    if (updateCardBtn) {
      updateCardBtn.addEventListener("click", () => {
        const tab = accountTabs.querySelector('[data-panel="payment"]');
        if (tab) tab.click();
        const panel = document.getElementById("paymentCard");
        if (panel && panel.scrollIntoView) panel.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }

    // İptal akışı: bağlantı → neden formu → POST /cancel (teklif sunucudan) → kabul / onay / vazgeç.
    const cancelSubLink = document.getElementById("cancelSubLink");
    if (cancelSubLink) {
      cancelSubLink.addEventListener("click", (e) => {
        e.preventDefault();
        cancelFlowOpen = true;
        setSubMsg("");
        renderSub();
      });
    }
    const cancelReasons = document.getElementById("cancelReasons");
    if (cancelReasons) {
      cancelReasons.querySelectorAll(".toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          cancelReasons.querySelectorAll(".toggle").forEach((b) => b.classList.toggle("active", b === btn));
        });
      });
      document.getElementById("requestCancelBtn").addEventListener("click", () => {
        const picked = cancelReasons.querySelector(".toggle.active");
        const reason = picked ? picked.getAttribute("data-reason") : "OTHER";
        const noteEl = document.getElementById("cancelReasonText");
        const note = noteEl ? noteEl.value.trim() : "";
        subBusy = true;
        setSubMsg("");
        renderSub();
        BahcedenCart.remote.cancel(reason, note).then(
          (res) => {
            cancelOffer = res && res.offer ? res.offer : null;
            cancelFlowOpen = false;
            // Talep açıldı: güncel DTO (CANCEL_REQUESTED + cancellation) sunucudan tazelenir.
            return BahcedenCart.remote.load(true).then(() => {
              subBusy = false;
              renderSub();
            });
          },
          (err) => {
            subBusy = false;
            setSubMsg((err && err.message) || T("genericError"));
            renderSub();
          },
        );
      });
      const cancelFlowBack = document.getElementById("cancelFlowBack");
      if (cancelFlowBack) {
        cancelFlowBack.addEventListener("click", (e) => {
          e.preventDefault();
          cancelFlowOpen = false;
          renderSub();
        });
      }
    }
    const useOfferBtn = document.getElementById("useOfferBtn");
    if (useOfferBtn) {
      useOfferBtn.addEventListener("click", () =>
        runSub(() => BahcedenCart.remote.acceptRetention(), "İndirim hakkın tanımlandı — aboneliğin devam ediyor."),
      );
    }
    const confirmCancelBtn = document.getElementById("confirmCancelBtn");
    if (confirmCancelBtn) {
      confirmCancelBtn.addEventListener("click", () =>
        runSub(() => BahcedenCart.remote.confirmCancel(), "Aboneliğin iptal edildi."),
      );
    }
    const abandonCancelBtn = document.getElementById("abandonCancelBtn");
    if (abandonCancelBtn) {
      abandonCancelBtn.addEventListener("click", () =>
        runSub(() => BahcedenCart.remote.abandonCancel(), "İptalden vazgeçildi — aboneliğin devam ediyor."),
      );
    }
  }

  // Abonelik kartı: bootstrap `sub` doluysa doğrudan çizilir; boşsa (C'nin bootstrap alanı gelmeden ya da
  // oturum sonrası tazeleme) GET /me/subscription ile bir kez çekilir (F9 yedek yolu).
  function loadAndRenderSub() {
    subLoadError = "";
    if (!BahcedenCart.isLoggedIn()) { renderSub(); return; }
    if (window.__BAGDAM__ && window.__BAGDAM__.sub) { renderSub(); return; }
    subCard.innerHTML = '<p class="pcard-meta mono">ABONELİK</p><p class="account-empty">' + escText(T("loading")) + "</p>";
    BahcedenCart.remote.load(true).then(renderSub, (err) => {
      // 404/NO_SUBSCRIPTION "abonelik yok" demektir — hata metni gösterilmez.
      subLoadError = err && err.status && err.status !== 404 ? (err.message || T("loadError")) : "";
      renderSub();
    });
  }
  loadAndRenderSub();

  // ---- Önceki siparişler — F8 checkout: GET /me/orders (OrderSummary; en yeni üstte). Satırlar "detay" ile
  // GET /me/orders/:orderNo'dan açılır. bahceden_orders localStorage kaydı kalktı. ----
  const ORDER_STATUS_TEXT = {
    PENDING_PAYMENT: ["ÖDEME BEKLİYOR", true], PAID: ["HAZIRLANIYOR", true], PREPARING: ["HAZIRLANIYOR", true],
    OUT_FOR_DELIVERY: ["YOLDA", true], DELIVERED: ["TESLİM EDİLDİ", false], DELIVERY_FAILED: ["TESLİM EDİLEMEDİ", true],
    CANCELLED: ["İPTAL EDİLDİ", false], REFUNDED: ["İADE EDİLDİ", false], PAYMENT_FAILED: ["ÖDEME BAŞARISIZ", true],
  };
  const ORDER_KIND_TEXT = { SUBSCRIPTION: "ABONELİK · ", BOX_ONE_TIME: "TEK SEFERLİK KUTU · ", SINGLE: "" };
  function orderDateParts(iso) {
    const d = iso ? new Date(iso) : null;
    if (!d || isNaN(d.getTime())) return { date: "—", time: "" };
    return {
      date: d.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" }),
      time: d.toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" }),
    };
  }
  function deliveryOnLabel(isoDate, dayId) {
    const d = isoDate ? new Date(isoDate + "T00:00:00") : null;
    if (d && !isNaN(d.getTime())) return d.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" }) + ", " + d.toLocaleDateString("tr-TR", { weekday: "long" });
    return (DELIVERY_DAYS.find((x) => x.id === dayId) || {}).label || "—";
  }
  function orderRowHtml(o) {
    const st = ORDER_STATUS_TEXT[o.status] || [escText(o.status || ""), true];
    const created = orderDateParts(o.createdAt);
    const kindLabel = ORDER_KIND_TEXT[o.kind] || "";
    return (
      '<div class="order-row" data-order-no="' + escAttr(o.orderNo) + '">' +
        '<div class="order-row-head">' +
          '<span class="mono order-no">' + kindLabel + "SİPARİŞ #" + escText(o.orderNo) + "</span>" +
          '<span class="order-status mono' + (st[1] ? " pending" : "") + '">' + st[0] + "</span>" +
        "</div>" +
        '<p class="order-meta mono">Sipariş: ' + created.date + (created.time ? " · " + created.time : "") + "</p>" +
        '<p class="order-meta mono">Teslimat: ' + deliveryOnLabel(o.deliveryOn, o.deliveryDay) + "</p>" +
        '<p class="order-lines" data-order-lines>' + (o.lineCount ? o.lineCount + " satır · " : "") + '<a href="#" data-order-detail>detayı gör</a></p>' +
        '<p class="order-total mono">' + money(o.grandTotal) + " TL</p>" +
      "</div>"
    );
  }
  function renderOrders() {
    const listEl = document.getElementById("ordersList");
    if (!BahcedenCart.isLoggedIn()) { listEl.innerHTML = ""; return; }
    listEl.innerHTML = '<p class="account-empty">Siparişlerin yükleniyor…</p>';
    BahcedenCart.listOrders().then((orders) => {
      if (!orders.length) {
        listEl.innerHTML = '<p class="account-empty">Henüz tamamlanmış bir siparişin yok.</p>';
        return;
      }
      listEl.innerHTML = orders.map(orderRowHtml).join("");
      listEl.querySelectorAll("[data-order-detail]").forEach((a) => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          const row = a.closest(".order-row");
          const linesEl = row.querySelector("[data-order-lines]");
          linesEl.textContent = "yükleniyor…";
          BahcedenCart.getOrder(row.getAttribute("data-order-no"))
            .then((order) => {
              const lines = (order && order.lines) || [];
              linesEl.textContent = lines.map((l) => {
                const qty = l.kind === "PRODUCT" ? " × " + l.qty : "";
                return l.name + qty + (l.pref ? " (" + l.pref + ")" : "");
              }).join(" · ") || "—";
            })
            .catch((err) => { linesEl.textContent = (err && err.message) || "Detay alınamadı."; });
        });
      });
    }).catch((err) => {
      listEl.innerHTML = '<p class="account-empty">' + escText((err && err.message) || "Siparişler yüklenemedi.") + "</p>";
    });
  }
  renderOrders();

  // ---- Teslimat adresi — F6 auth: GET/PUT /me/address (tek adres); ilçe = teslimat bölgesi
  // (GET /delivery/zones; ADR-0003 istisna 5: #addrDistrict text→select). Ödeme yöntemiyle aynı
  // kalıp: kayıtlıysa özet + "adresi düzenle" butonu, düzenle deyince (ya da hiç kayıt yoksa) form. ----
  const addressCard = document.getElementById("addressCard");

  function escAttr(v) { return String(v || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;"); }
  function escText(v) { return String(v || "").replace(/&/g, "&amp;").replace(/</g, "&lt;"); }

  function renderAddressSaved(addr) {
    addressCard.innerHTML =
      '<p class="account-empty">' +
        escText(addr.name) + " — " + escText(addr.phone) + "<br>" +
        escText(addr.line) + ", " + escText(addr.district) + (addr.zip ? " " + escText(addr.zip) : "") +
      "</p>" +
      '<button class="btn" type="button" id="editAddrBtn">adresi düzenle</button>';
    document.getElementById("editAddrBtn").addEventListener("click", () => renderAddressForm(addr));
  }

  function renderAddressForm(addr) {
    addr = addr || {};
    const zones = BahcedenCart.getZones();
    const selectedZone = addr.zoneSlug || (addr.district ? BahcedenCart.zoneSlugFor(addr.district) : "");
    const zoneOptions = '<option value="">Seç</option>' + zones.map((z) =>
      '<option value="' + escAttr(z.slug) + '"' + (z.slug === selectedZone ? " selected" : "") + ">" + escText(z.name) + "</option>"
    ).join("");
    // checkout-form sınıfı yalnız select'in site stilini alması için (account-form'da select kuralı yok; styles.css'e dokunulmaz).
    addressCard.innerHTML =
      '<form class="account-form checkout-form" id="addressForm">' +
        '<label>Ad Soyad<input type="text" id="addrName" placeholder="Ad Soyad" value="' + escAttr(addr.name) + '" required></label>' +
        '<label>Telefon<input type="tel" id="addrPhone" placeholder="05xx xxx xx xx" value="' + escAttr(addr.phone) + '" required></label>' +
        '<label>Adres<textarea id="addrLine" placeholder="Mahalle, sokak, no, daire" required>' + escText(addr.line) + "</textarea></label>" +
        '<div class="form-row">' +
          '<label>İlçe<select id="addrDistrict" required>' + zoneOptions + "</select></label>" +
          '<label>Posta Kodu<input type="text" id="addrZip" placeholder="35xxx" value="' + escAttr(addr.zip) + '"></label>' +
        "</div>" +
        '<p class="checkout-auth-msg mono" id="addrMsg" hidden></p>' +
        '<button class="cta" type="submit" id="addrSubmit">adresi kaydet</button>' +
      "</form>";
    const msgEl = document.getElementById("addrMsg");
    document.getElementById("addressForm").addEventListener("submit", (e) => {
      e.preventDefault();
      const draft = {
        name: document.getElementById("addrName").value.trim(),
        phone: document.getElementById("addrPhone").value.trim(),
        line: document.getElementById("addrLine").value.trim(),
        zoneSlug: document.getElementById("addrDistrict").value,
        zip: document.getElementById("addrZip").value.trim(),
      };
      if (!draft.name || !draft.phone || !draft.line || !draft.zoneSlug) {
        msgEl.textContent = "Ad soyad, telefon, adres ve ilçe zorunlu.";
        msgEl.hidden = false;
        return;
      }
      const submitBtn = document.getElementById("addrSubmit");
      submitBtn.disabled = true;
      msgEl.hidden = true;
      BahcedenCart.setAddress(draft)
        .then((saved) => renderAddressSaved(saved))
        .catch((err) => { submitBtn.disabled = false; msgEl.textContent = err.message; msgEl.hidden = false; });
    });
  }

  function renderAddress() {
    if (!BahcedenCart.isLoggedIn()) { addressCard.innerHTML = ""; return; }
    const existingAddr = BahcedenCart.getAddress();
    if (existingAddr && existingAddr.name && existingAddr.line) {
      renderAddressSaved(existingAddr);
    } else {
      renderAddressForm(existingAddr);
    }
  }
  // Adres sunucudan gelir: bölgeler + adres yüklenince çizilir (oturum yoksa kart zaten gizli).
  function loadAndRenderAddress() {
    if (!BahcedenCart.isLoggedIn()) { renderAddress(); return; }
    addressCard.innerHTML = '<p class="account-empty">Adresin yükleniyor…</p>';
    BahcedenCart.loadZones()
      .then(() => BahcedenCart.loadAddress())
      .then(renderAddress, (err) => {
        addressCard.innerHTML = '<p class="account-empty">' + escText(err && err.message ? err.message : "Adres yüklenemedi.") + "</p>";
      });
  }
  loadAndRenderAddress();

  // ---- Payment method — F8 checkout: saklı kartlar sunucudan (GET /me/cards → PaymentMethod: yalnız PSP token özeti,
  // kart verisi bizde yok). Kart formu kalktı: kart ilk ödemede (PayTR iFrame) saklanır; "yeni kart ekle" →
  // POST /me/cards/add-session (PayTR'de 501 → mesaj). Kaldır → DELETE /me/cards/:id. ----
  const paymentCard = document.getElementById("paymentCard");
  let paymentCards = [];

  function renderPaymentList() {
    const rows = paymentCards.map((c) =>
      '<p class="account-empty">•••• •••• •••• ' + escText(c.last4 || "") +
        (c.brand ? " — " + escText(c.brand) : "") + (c.holderName ? " — " + escText(c.holderName) : "") +
        (c.expMonth && c.expYear ? ' <span class="mono">(' + String(c.expMonth).padStart(2, "0") + "/" + String(c.expYear).slice(-2) + ")</span>" : "") +
        (c.isDefault ? ' <span class="mono">· varsayılan</span>' : "") +
        ' <a href="#" class="cart-remove mono" data-remove-card="' + escAttr(c.id) + '">kaldır</a>' +
      "</p>"
    ).join("");
    paymentCard.innerHTML =
      (rows || '<p class="account-empty">Kayıtlı kartın yok — kartın ilk ödemende güvenle saklanır (kart bilgileri bizde tutulmaz).</p>') +
      '<p class="checkout-auth-msg mono" id="cardMsg" hidden></p>' +
      '<button class="btn" type="button" id="addCardBtn">yeni kart ekle</button>';
    const msgEl = document.getElementById("cardMsg");
    function showCardMsg(text, ok) { msgEl.textContent = text || ""; msgEl.hidden = !text; msgEl.style.color = ok ? "var(--olive-deep)" : ""; }
    paymentCard.querySelectorAll("[data-remove-card]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const id = a.getAttribute("data-remove-card");
        BahcedenCart.removeCard(id)
          .then(() => { paymentCards = paymentCards.filter((c) => c.id !== id); renderPaymentList(); })
          .catch((err) => showCardMsg((err && err.message) || "Kart kaldırılamadı."));
      });
    });
    document.getElementById("addCardBtn").addEventListener("click", () => {
      const btn = document.getElementById("addCardBtn");
      btn.disabled = true;
      BahcedenCart.cardAddSession()
        .then((res) => {
          btn.disabled = false;
          if (res && res.redirectUrl) { window.location.href = res.redirectUrl; return; }
          showCardMsg((res && res.message) || "Kart ekleme ekranı açılamadı.", true);
        })
        .catch((err) => {
          btn.disabled = false;
          // 501 (PayTR'de ayrı kart ekleme yok — kart ilk ödemede saklanır) ve 404 (uç yok): teknik zarf yerine sabit not.
          const noSession = !!err && (err.status === 501 || err.status === 404);
          showCardMsg(noSession ? "Kart ekleme için ayrı bir ekran yok — kartın bir sonraki ödemende güvenle saklanır." : ((err && err.message) || "Kart eklenemedi."), noSession);
        });
    });
  }

  function renderPayment() {
    if (!BahcedenCart.isLoggedIn()) { paymentCard.innerHTML = ""; return; }
    paymentCard.innerHTML = '<p class="account-empty">Kartların yükleniyor…</p>';
    BahcedenCart.listCards()
      .then((cards) => { paymentCards = (cards || []).filter((c) => c && c.isActive !== false); renderPaymentList(); })
      .catch((err) => { paymentCard.innerHTML = '<p class="account-empty">' + escText((err && err.message) || "Kartlar yüklenemedi.") + "</p>"; });
  }
  renderPayment();

  // Giriş / üye ol / çıkış sonrası tüm kartlar depodan yeniden çizilir —
  // yeni üye temiz hesap görür, eski üyenin bilgileri ekranda kalmaz.
  onAuthChange = () => {
    subDraft = null;
    skipConfirmOpen = false;
    cancelFlowOpen = false;
    cancelOffer = null;
    subBusy = false;
    setSubMsg("");
    // F8 checkout / F9 remote: çıkışta sunucu aboneliği görünmez (kayıt durur, arayüz misafir görünümüne döner).
    if (!BahcedenCart.isLoggedIn()) BahcedenCart.applyServerSub(null);
    loadAndRenderSub();
    renderOrders();
    loadAndRenderAddress();
    renderPayment();
  };

  document.getElementById("logoutLink").addEventListener("click", (e) => {
    e.preventDefault();
    // F6 auth: POST /auth/logout (çerezler sunucuda silinir) → oturum değişince wireAuthGate refresh'i koşar,
    // sayfa "çıkış" durumuna döner (yenileme gerekmez).
    BahcedenCart.logout();
  });
})();
</script>

</body>
</html>
