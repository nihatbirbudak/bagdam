<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — günlük</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html" class="on">blog</a>
      <a href="toptan.html">toptan</a>
      <a href="nasil-seciyoruz.html">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
</header>

<main>
  <section class="journal-hero">
    <img class="soon-icon" src="assets/logo/logo-icon.svg" alt="">
    <span class="eyebrow">{{{site.gunluk.hero.eyebrow}}}</span>
    <h1>{{{site.gunluk.hero.title}}}</h1>
    <p>{{{site.gunluk.hero.sub}}}</p>
  </section>

{{#each posts}}
{{> journal_post}}
{{#unless @last}}

{{/unless}}
{{/each}}

  <section class="journal-close">
    <h2>{{{site.gunluk.close.title}}}</h2>
    <a class="btn" href="{{{site.gunluk.close.ctaHref}}}">{{{site.gunluk.close.ctaText}}}</a>
  </section>
</main>

{{> cookie_consent}}
{{> site_footer}}

{{> bootstrap}}
</body>
</html>
