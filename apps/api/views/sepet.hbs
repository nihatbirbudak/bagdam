<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — sepet</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html">blog</a>
      <a href="toptan.html">toptan</a>
      <a href="nasil-seciyoruz.html">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
</header>

<main>
  <section class="shop-hero">
    <div class="shop-hero-icon-wrap">
      <div class="floating-cart-fill-row" id="shopHeroFillRow"></div>
      <img class="shop-hero-icon" src="assets/icons/sepet-1.png" alt="Sepetin">
    </div>
    <h1>sipariş öncesi <em>son adımlar</em></h1>
  </section>

  <!-- Mobil adım sekmeleri: özet → müşteri → teslimat → ödeme. Masaüstünde
       gizli (orada sol adımlar + sağ özet yan yana). Giriş yapılınca görünür;
       her adım tamamlandıkça sonraki açılır ve otomatik geçilir. -->
  <div class="checkout-steps" id="checkoutSteps" hidden>
    <button class="checkout-step active" type="button" data-step="summary"><span class="checkout-step-num mono">1</span><span>Özet</span></button>
    <button class="checkout-step" type="button" data-step="customer" disabled><span class="checkout-step-num mono">2</span><span>Müşteri</span></button>
    <button class="checkout-step" type="button" data-step="delivery" disabled><span class="checkout-step-num mono">3</span><span>Teslimat</span></button>
    <button class="checkout-step" type="button" data-step="payment" disabled><span class="checkout-step-num mono">4</span><span>Ödeme</span></button>
  </div>

  <div class="checkout-layout">
    <div class="checkout-left">
      <section class="checkout-auth" id="checkoutAuth">
        <div class="checkout-auth-tabs">
          <button class="checkout-auth-tab active" type="button" data-mode="login">giriş yap</button>
          <button class="checkout-auth-tab" type="button" data-mode="signup">üye ol</button>
        </div>
        <div class="checkout-form" id="authFormLogin">
          <label>E-posta<input type="email" id="loginEmail" placeholder="ornek@eposta.com"></label>
          <label>Parola<input type="password" id="loginPassword" placeholder="••••••••"></label>
          <p class="checkout-auth-msg mono" id="loginMsg" hidden></p>
          <button class="cta wide" type="button" id="loginSubmit">giriş yap</button>
          <!-- F6 — ADR-0003 istisna 4: parolamı unuttum (POST /auth/forgot) -->
          <p class="cancel-note" id="forgotNote"><a href="#" id="forgotLink">parolamı unuttum</a></p>
        </div>
        <div class="checkout-form" id="authFormSignup" hidden>
          <label>E-posta<input type="email" id="signupEmail" placeholder="ornek@eposta.com"></label>
          <label>E-posta (Tekrar)<input type="email" id="signupEmailConfirm" placeholder="ornek@eposta.com"></label>
          <label>Parola<input type="password" id="signupPassword" placeholder="••••••••"></label>
          <label>Parola (Tekrar)<input type="password" id="signupPasswordConfirm" placeholder="••••••••"></label>
          <!-- F6 — ADR-0003 istisna 2: KVKK aydınlatma onayı (zorunlu) + pazarlama izni (isteğe bağlı). Yalnız bu blok; styles.css'e dokunulmaz. -->
          <style>
            .checkout-form .consent-row{ flex-direction:row; align-items:flex-start; gap:10px; text-transform:none; letter-spacing:0; font-size:12px; line-height:1.45; color:var(--ink-soft); cursor:pointer; }
            .checkout-form .consent-row input{ appearance:auto; -webkit-appearance:checkbox; width:15px; height:15px; padding:0; margin:2px 0 0; flex:none; accent-color:var(--olive-deep); }
            .checkout-form .consent-row a{ color:var(--fig-deep); text-decoration:underline; text-underline-offset:3px; }
          </style>
          <label class="consent-row"><input type="checkbox" id="signupKvkk"><span><a href="politikalar.html#kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>'ni okudum; kişisel verilerimin bu kapsamda işleneceğini biliyorum. <span class="mono">(zorunlu)</span></span></label>
          <label class="consent-row"><input type="checkbox" id="signupMarketing"><span>Kampanya ve yeniliklerden e-posta ile haberdar olmak istiyorum (<a href="politikalar.html#ticari-ileti-izni" target="_blank" rel="noopener">ticari elektronik ileti izni</a>, isteğe bağlı).</span></label>
          <p class="checkout-auth-msg mono" id="signupMsg" hidden></p>
          <button class="cta wide" type="button" id="signupSubmit">üye ol</button>
        </div>
      </section>

      <div class="checkout-sections" id="checkoutSections" hidden>
        <section class="checkout-section" id="customerSection">
          <h2 class="checkout-section-title">
            <span class="section-title-left">
              <span class="section-check" id="customerCheck"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
              <span>Müşteri Bilgileri</span>
            </span>
            <button class="section-toggle" id="customerToggle" type="button" aria-label="Müşteri bilgilerini aç/kapat">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </h2>
          <div class="checkout-form" id="customerForm">
            <label>Ad Soyad<input type="text" id="custName" placeholder="Ad Soyad" required></label>
            <label>E-posta<input type="email" id="custEmail" placeholder="ornek@eposta.com" required></label>
            <label>Telefon<input type="tel" id="custPhone" placeholder="05xx xxx xx xx" required></label>
            <label>Adres<textarea id="custAddress" placeholder="Mahalle, sokak, no, daire" required></textarea></label>
            <div class="form-row">
              <label>İlçe
                <select id="custDistrict" required>
                  <option value="">Seç</option>
                  <option value="Urla">Urla</option>
                  <option value="Çeşme">Çeşme</option>
                </select>
              </label>
              <label>Posta Kodu<input type="text" id="custZip" placeholder="35xxx"></label>
            </div>
          </div>
        </section>

        <section class="checkout-section" id="deliverySection">
          <h2 class="checkout-section-title">
            <span class="section-title-left">
              <span class="section-check" id="deliveryCheck"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
              <span>Teslimat Bilgileri</span>
            </span>
            <button class="section-toggle" id="deliveryToggle" type="button" aria-label="Teslimat bilgilerini aç/kapat">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </h2>
          <div class="checkout-form" id="deliveryForm" hidden>
            <span class="pcard-pref-label mono">teslimat günü</span>
            <div class="toggle-list small" id="checkoutDeliveryDay"><!-- filled by JS --></div>
            <p class="day-note mono" id="checkoutDayNote" hidden></p>
            <p class="checkout-shipping-note mono" id="checkoutShippingNote"></p>
          </div>
        </section>

        <section class="checkout-section" id="paymentSection">
          <h2 class="checkout-section-title">
            <span class="section-title-left">
              <span class="section-check" id="paymentCheck"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
              <span>Ödeme Bilgileri</span>
            </span>
            <button class="section-toggle" id="paymentToggle" type="button" aria-label="Ödeme bilgilerini aç/kapat">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </h2>
          <div class="checkout-form" id="paymentForm" hidden>
            <div class="payment-method-option">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="1.5"/><path d="M2 9.5h20"/></svg>
              Kredi Kartı / Banka Kartı
            </div>
            <!-- F8 — ADR-0003 istisna 1: prototipteki 4 alanlı kart formu yerine PayTR iFrame konteyneri (aynı kutu içinde);
                 kart verisi hiçbir zaman bize gelmez (ADR-0019). Saklı kartlar (PaymentMethod) varsa üstte seçilir. Yalnız bu blok; styles.css'e dokunulmaz. -->
            <style>
              .checkout-payment-frame{ border:1px solid var(--line-strong); background:var(--bg); }
              .checkout-payment-frame.is-empty{ display:flex; align-items:center; justify-content:center; min-height:96px; padding:18px 14px; font-size:12px; color:var(--ink-soft); text-align:center; line-height:1.5; }
              .checkout-payment-frame iframe{ display:block; width:100%; min-height:460px; border:0; }
              .checkout-payment-frame .checkout-payment-test{ padding:18px 14px; font-size:12px; color:var(--olive-deep); line-height:1.5; }
              #savedCards .toggle{ text-transform:none; letter-spacing:0; }
              .checkout-form.coupon-row{ margin-top:22px; }
              .coupon-field{ display:flex; gap:8px; }
              .coupon-field input{ flex:1 1 auto; min-width:0; }
              .coupon-field .btn{ flex:none; white-space:nowrap; padding:12px 16px; }
              .coupon-msg.ok{ color:var(--olive-deep); }
              /* Mobil adım akışı: onay kutuları + sipariş mesajı yalnız ödeme adımında (styles.css #checkoutComplete kuralıyla aynı). */
              @media (max-width:900px){
                #checkoutLegal, #checkoutMsg{ display:none; }
                .checkout-sections:has(#paymentSection:not(.step-hidden)) #checkoutLegal:not([hidden]){ display:flex; }
                .checkout-sections:has(#paymentSection:not(.step-hidden)) #checkoutMsg:not([hidden]){ display:block; }
              }
            </style>
            <div class="toggle-list small" id="savedCards" hidden><!-- filled by JS --></div>
            <div class="checkout-payment-frame is-empty" id="paymentFrame">Güvenli ödeme ekranı "siparişi tamamla"ya bastıktan sonra burada açılır — kart bilgilerin PayTR'de girilir, bizde saklanmaz.</div>
            <p class="checkout-auth-msg mono" id="paymentMsg" hidden></p>
          </div>
        </section>

        <!-- F8 — ADR-0003 istisna 3: checkout belge onayı (requiresAck: ön bilgilendirme, mesafeli satış, abonelikte abonelik sözleşmesi)
             + buton metni "siparişi tamamla — ödeme yükümlülüğü doğurur". Yalnız bu blok. -->
        <div class="checkout-form" id="checkoutLegal" hidden><!-- filled by JS --></div>
        <button class="cta wide" id="checkoutComplete" type="button">siparişi tamamla — ödeme yükümlülüğü doğurur</button>
        <p class="checkout-auth-msg mono" id="checkoutMsg" hidden></p>
        <p class="checkout-success mono" id="checkoutSuccess" hidden>Siparişin alındı — teşekkürler!</p>
      </div>
    </div>

    <div class="checkout-right">
      <section class="checkout-summary" id="cartWrap"><!-- filled by JS --></section>
    </div>
  </div>
</main>

{{> cookie_consent}}
{{> site_footer}}
<!-- F9 CMS — sepet (checkout) metinleri (SiteContent `sepet.texts`). <template> hiçbir zaman RENDER EDİLMEZ
     (piksel parite etkilenmez) ve dataset okuması HTML varlıklarını çözer; SiteContent metin alanları sunucuda
     kaçışlanır, bu yüzden üç süslü parantezli (ham) yazım kullanılır. Anahtar yoksa/boşsa sayfa kendi Türkçe
     varsayılanına düşer (SEPET_TEXT_DEFAULTS) — markup'taki sabit metinler de aynı varsayılanlardır. -->
<template id="sepetTexts"
  data-step-summary-label="{{{site.sepet.texts.stepSummaryLabel}}}"
  data-step-customer-label="{{{site.sepet.texts.stepCustomerLabel}}}"
  data-step-delivery-label="{{{site.sepet.texts.stepDeliveryLabel}}}"
  data-step-payment-label="{{{site.sepet.texts.stepPaymentLabel}}}"
  data-summary-title="{{{site.sepet.texts.summaryTitle}}}"
  data-customer-title="{{{site.sepet.texts.customerTitle}}}"
  data-delivery-title="{{{site.sepet.texts.deliveryTitle}}}"
  data-payment-title="{{{site.sepet.texts.paymentTitle}}}"
  data-empty-cart="{{{site.sepet.texts.emptyCart}}}"
  data-complete-cta="{{{site.sepet.texts.completeCta}}}"
  data-add-to-box-cta="{{{site.sepet.texts.addToBoxCta}}}"
  data-shipping-label="{{{site.sepet.texts.shippingLabel}}}"
  data-shipping-included-label="{{{site.sepet.texts.shippingIncludedLabel}}}"
  data-customer-required-error="{{{site.sepet.texts.customerRequiredError}}}"
  data-cart-empty-error="{{{site.sepet.texts.cartEmptyError}}}"
  data-delivery-day-required-error="{{{site.sepet.texts.deliveryDayRequiredError}}}"
  data-delivery-date-error="{{{site.sepet.texts.deliveryDateError}}}"
  data-legal-required-error="{{{site.sepet.texts.legalRequiredError}}}"
  data-legal-single-required-error="{{{site.sepet.texts.legalSingleRequiredError}}}"
  data-quote-error="{{{site.sepet.texts.quoteError}}}"
  data-order-error="{{{site.sepet.texts.orderError}}}"
  data-order-response-error="{{{site.sepet.texts.orderResponseError}}}"
  data-order-not-found-error="{{{site.sepet.texts.orderNotFoundError}}}"
  data-payment-pending-note="{{{site.sepet.texts.paymentPendingNote}}}"
  data-payment-verifying-note="{{{site.sepet.texts.paymentVerifyingNote}}}"
  data-payment-timeout-note="{{{site.sepet.texts.paymentTimeoutNote}}}"
  data-payment-failed-note="{{{site.sepet.texts.paymentFailedNote}}}"
  data-success-order="{{{site.sepet.texts.successOrder}}}"
  data-success-subscription="{{{site.sepet.texts.successSubscription}}}"></template>

{{> bootstrap}}
<script>window.__BAGDAM_CHECKOUT__ = {{{checkoutJson}}};</script>
<script>
(function () {
  // F8 checkout: PayTR ok/fail dönüş sayfası (sepet.html?siparis=<no>&odeme=ok|hata) ödeme iFrame'inin İÇİNDE
  // yüklenirse üst pencereye çıkar; çıkamazsa üst pencereye haber verir (aşağıdaki "message" dinleyicisi).
  try {
    if (window.top !== window.self && /[?&]siparis=/.test(window.location.search)) {
      try { window.top.location.href = window.location.href; } catch (e) { /* üst pencere yönlendirmeyi engelledi */ }
      try { window.parent.postMessage({ bagdamCheckout: window.location.search }, window.location.origin); } catch (e2) { /* yok say */ }
    }
  } catch (e) { /* yok say */ }

  function money(n) { return Number(n || 0).toLocaleString("tr-TR", { maximumFractionDigits: 2 }); }
  function escText(v) { return String(v == null ? "" : v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
  function escAttr(v) { return escText(v).replace(/"/g, "&quot;"); }
  // ---- F9 CMS: sepet metinleri (SiteContent `sepet.texts` → <template id="sepetTexts" data-*>) ----
  // Anahtar yoksa/boşsa aşağıdaki varsayılan kullanılır; varsayılanlar markup'taki sabit metinlerle BİREBİR
  // aynıdır → anonim görünüm (ve piksel paritesi) değişmez. Yer tutucular JS tarafında doldurulur:
  // {no} sipariş numarası (successOrder/successSubscription), {belge} onay bekleyen yasal belge adı.
  const SEPET_TEXT_DEFAULTS = {
    stepSummaryLabel: "Özet",
    stepCustomerLabel: "Müşteri",
    stepDeliveryLabel: "Teslimat",
    stepPaymentLabel: "Ödeme",
    summaryTitle: "Sipariş Özeti",
    customerTitle: "Müşteri Bilgileri",
    deliveryTitle: "Teslimat Bilgileri",
    paymentTitle: "Ödeme Bilgileri",
    emptyCart: "sepetin boş.",
    completeCta: "siparişi tamamla — ödeme yükümlülüğü doğurur",
    addToBoxCta: "bu haftaki kutuma ekle",
    shippingLabel: "Kargo",
    shippingIncludedLabel: "Dahil",
    customerRequiredError: "Müşteri bilgilerini tamamla.",
    cartEmptyError: "Sepetin boş.",
    deliveryDayRequiredError: "Teslimat gününü seç.",
    deliveryDateError: "Teslimat tarihi alınamadı — sayfayı yenileyip tekrar dene.",
    legalRequiredError: "Devam etmek için belgeleri onayla.",
    legalSingleRequiredError: "{belge} onayı gerekli.",
    quoteError: "Tutar hesaplanamadı — tekrar dene.",
    orderError: "Sipariş oluşturulamadı — tekrar dene.",
    orderResponseError: "Sipariş yanıtı alınamadı — üyelik sayfandan siparişlerini kontrol et.",
    orderNotFoundError: "Sipariş bulunamadı — üyelik sayfandaki \"önceki siparişler\"den kontrol edebilirsin.",
    paymentPendingNote: "Ödemeni güvenli ekranda tamamla — sonucu burada göreceğiz.",
    paymentVerifyingNote: "Ödemen doğrulanıyor — birkaç saniye…",
    paymentTimeoutNote: "Ödeme sonucu henüz bize ulaşmadı — siparişinin durumunu üyelik sayfandaki \"önceki siparişler\"den takip edebilirsin.",
    paymentFailedNote: "Ödeme alınamadı — kartını kontrol edip \"siparişi tamamla\" ile yeniden deneyebilirsin.",
    successOrder: "Siparişin alındı (#{no}) — teşekkürler! Siparişlerini <a href=\"uyelik.html\">üyelik sayfandan</a> takip edebilirsin.",
    successSubscription: "Siparişin alındı (#{no}) — teşekkürler! Aboneliğini <a href=\"uyelik.html\">üyelik sayfandan</a> yönetebilirsin.",
  };
  // Manuel sağlayıcı (lokal/e2e) notu CMS'te değil: gerçek tahsilat yapılmayan ortamlarda önüne eklenir.
  const MANUAL_PAYMENT_PREFIX = "Test ödeme onaylandı — ";
  const sepetTextsEl = document.getElementById("sepetTexts");
  function T(key) {
    const raw = sepetTextsEl && sepetTextsEl.dataset ? sepetTextsEl.dataset[key] : "";
    return raw && String(raw).trim() ? String(raw) : SEPET_TEXT_DEFAULTS[key];
  }
  function fill(text, vars) {
    return String(text).replace(/\{(\w+)\}/g, (m, k) => (vars && vars[k] !== undefined ? String(vars[k]) : m));
  }
  // Markup'ta duran sabit metinler (adım sekmeleri, bölüm başlıkları, "siparişi tamamla") CMS değeriyle
  // değiştirilir. Anahtar boşken varsayılan = markup metni → hiçbir şey değişmez (parite korunur).
  function applyStaticTexts() {
    const map = [
      ['#checkoutSteps [data-step="summary"] span:last-child', "stepSummaryLabel"],
      ['#checkoutSteps [data-step="customer"] span:last-child', "stepCustomerLabel"],
      ['#checkoutSteps [data-step="delivery"] span:last-child', "stepDeliveryLabel"],
      ['#checkoutSteps [data-step="payment"] span:last-child', "stepPaymentLabel"],
      ["#customerSection .section-title-left > span:last-child", "customerTitle"],
      ["#deliverySection .section-title-left > span:last-child", "deliveryTitle"],
      ["#paymentSection .section-title-left > span:last-child", "paymentTitle"],
      ["#checkoutComplete", "completeCta"],
    ];
    map.forEach((pair) => {
      const el = document.querySelector(pair[0]);
      if (el) el.textContent = T(pair[1]);
    });
  }
  applyStaticTexts();
  var stepsEl = null, stepBtns = null, stepPanels = null; // mobil adım sekmeleri (aşağıda kurulur)

  // ---- F8 checkout durumu (aşağıdaki bölümler okur/yazar; ilk refreshSections() çağrısından önce tanımlı olmalı) ----
  let deliveryDates = [];        // GET /delivery/dates?zone= (sıralı)
  let deliveryDatesZone = null;  // yüklü listenin bölgesi
  let deliveryDatesError = null;
  let selectedDate = null;       // {day, date, cutoffAtIso, locked, full[, id]} — checkout deliveryOn (id varsa deliveryDateId)
  let legalDocs = [];            // requiresAck belgeler [{slug, kind, title, version}]
  const legalChecked = {};       // slug → onaylandı mı (yeniden çizimde korunur)
  let quote = null;              // POST /checkout/quote sonucu (PricingResult + couponStatus)
  let quoteError = null;
  let quoteSeq = 0;
  let quoteTimer = null;
  let lastQuoteKey = null;
  let couponCode = "";
  let poller = null;             // pollOrderStatus promise'i (stop())

  // ---- Auth gate: shared login/signup wiring lives in cart.js so
  // sepet.html and uyelik.html don't each carry their own copy. Giriş/üyelik
  // durumu her değiştiğinde formlar depodan yeniden dolar — böylece yeni
  // üye olan biri, önceki üyenin ekranda kalmış bilgilerini görmez.
  // (wireAuthGate kurulurken bir kez hemen çağrılır — o anda form alanları
  // henüz tanımlı değil; ilk çağrı atlanır, formlar aşağıda elle dolar.)
  let formsReady = false;
  const refreshAuthGate = BahcedenCart.wireAuthGate("checkoutSections", (loggedIn) => {
    if (!formsReady) return;
    // F6 auth: giriş sayfa yenilemesiyle gelir; buraya çıkış / oturum düşmesi (ve ileride anlık giriş) düşer.
    if (loggedIn) { loadProfileIntoForms(); return; }
    stopPolling();
    fillFormsFromStore();
    render();
  });

  // ---- Customer form — same address store uyelik.html reads/writes ----
  const custName = document.getElementById("custName");
  const custEmail = document.getElementById("custEmail");
  const custPhone = document.getElementById("custPhone");
  const custAddress = document.getElementById("custAddress");
  const custDistrict = document.getElementById("custDistrict");
  const custZip = document.getElementById("custZip");

  // F8 checkout: ilçe seçenekleri bölge listesinden (GET /delivery/zones; sepet.hbs'e gömülü kopya ile hızlı başlar) —
  // değer bölge ADI (F6 sözleşmesi: district ↔ zoneSlug çevirisi cart.js'te).
  function fillDistrictOptions() {
    const zones = BahcedenCart.getZones();
    if (!zones || !zones.length) return;
    const current = custDistrict.value;
    custDistrict.innerHTML = '<option value="">Seç</option>' + zones.map((z) => '<option value="' + escAttr(z.name) + '">' + escText(z.name) + "</option>").join("");
    if (current && zones.some((z) => z.name === current)) custDistrict.value = current;
  }

  function fillFormsFromStore() {
    // F6 auth: adres sunucu önbelleğinden (BahcedenCart.loadAddress → getAddress), e-posta oturumdan (bahceden_address kalktı).
    const a = BahcedenCart.getAddress() || {};
    const user = BahcedenCart.me();
    custName.value = a.name || "";
    // F8 checkout: e-posta = hesabın e-postası (Order.customerEmail = User.email) — değiştirilemez.
    custEmail.value = (user && user.email) || "";
    custEmail.readOnly = !!user;
    custPhone.value = a.phone || "";
    custAddress.value = a.line || "";
    custDistrict.value = a.district || "";
    custZip.value = a.zip || "";
    addressDirty = false;
  }
  // F6 auth: bölgeler + adres sunucudan; hata olursa boş form (elle doldurulur, sepet akışı kesilmez).
  // F8 checkout: ardından saklı kartlar, onay gerektiren belgeler, satın alınmış abonelik (GET /me/subscription — minimal, F9 tam)
  // ve teslimat tarihleri yüklenir; ?siparis= dönüşü varsa sipariş durumu izlenir.
  function loadProfileIntoForms() {
    BahcedenCart.loadZones()
      .then(() => { fillDistrictOptions(); return BahcedenCart.loadAddress(); })
      .catch(() => null)
      .then(() => { fillFormsFromStore(); return BahcedenCart.loadSubscription().catch(() => null); })
      .then(() => {
        render();
        loadDatesForZone();
        loadCards();
        loadLegal();
        handleReturnFromPayment();
      });
  }
  // F6 auth: adres PUT /me/address ile sunucuya (tek adres) — yalnız oturumlu ve zorunlu alanlar tamamken;
  // alan değişimlerinde (change) kısa gecikmeyle, her tuşta değil.
  let saveAddressTimer = null;
  let addressDirty = false; // F8 checkout: son sunucu kaydından beri form değişti mi (checkout öncesi zorunlu PUT)
  function addressFromForm() {
    return {
      name: custName.value.trim(),
      phone: custPhone.value.trim(),
      line: custAddress.value.trim(),
      district: custDistrict.value,
      zip: custZip.value.trim(),
    };
  }
  function saveCustomerForm() {
    if (!BahcedenCart.isLoggedIn() || !customerComplete()) return;
    clearTimeout(saveAddressTimer);
    saveAddressTimer = setTimeout(() => {
      const snapshot = addressFromForm();
      BahcedenCart.setAddress(snapshot)
        .then(() => { if (JSON.stringify(snapshot) === JSON.stringify(addressFromForm())) addressDirty = false; })
        .catch(() => { /* sepet akışını kesmez; siparişte yeniden denenir */ });
    }, 400);
  }
  // F8 checkout: sipariş öncesi adresin sunucuda ve güncel olduğundan emin ol → addressId.
  function ensureAddressSaved() {
    const cached = BahcedenCart.getAddress();
    if (cached && cached.id && !addressDirty) return Promise.resolve(cached.id);
    clearTimeout(saveAddressTimer);
    return BahcedenCart.setAddress(addressFromForm()).then((saved) => {
      addressDirty = false;
      if (!saved || !saved.id) throw { message: "Adres kaydedilemedi — lütfen tekrar dene." };
      return saved.id;
    });
  }
  // Delivery and Payment stay collapsed to just their title until every
  // required customer field is filled — same "one step unlocks the next"
  // pattern as a normal checkout, just without a real backend behind it.
  // Customer collapses the other way: once it's complete and the next two
  // steps open up, its own form drops out of the way.
  const customerSection = document.getElementById("customerSection");
  const customerForm = document.getElementById("customerForm");
  const deliverySection = document.getElementById("deliverySection");
  const paymentSection = document.getElementById("paymentSection");
  const deliveryForm = document.getElementById("deliveryForm");
  const paymentForm = document.getElementById("paymentForm");

  function customerComplete() {
    return !!(
      custName.value.trim() &&
      custEmail.value.trim() &&
      custPhone.value.trim() &&
      custAddress.value.trim() &&
      custDistrict.value
    );
  }

  // ---- Payment — F8 checkout: kart formu yok; ödeme PayTR iFrame'inde (ya da saklı kartla) alınır.
  // "Ödeme tamam" = sipariş PAID (GET /orders/:no/status). ----
  const savedCardsEl = document.getElementById("savedCards");
  const paymentFrameEl = document.getElementById("paymentFrame");
  const paymentMsgEl = document.getElementById("paymentMsg");
  const checkoutMsgEl = document.getElementById("checkoutMsg");
  const legalEl = document.getElementById("checkoutLegal");
  const PAYMENT_FRAME_EMPTY_TEXT = paymentFrameEl.textContent;
  const checkoutState = { busy: false, orderNo: null, awaiting: false, paid: false, provider: null, subscription: false };
  let cards = [];
  let paymentMethodId = null;
  fillFormsFromStore();
  formsReady = true;
  function paymentComplete() {
    return checkoutState.paid;
  }
  function showMsg(el, text, ok) {
    if (!el) return;
    el.textContent = text || "";
    el.hidden = !text;
    el.style.color = ok ? "var(--olive-deep)" : "";
  }
  function loadCards() {
    if (!BahcedenCart.isLoggedIn()) { cards = []; renderCards(); return; }
    BahcedenCart.listCards()
      .then((list) => { cards = (list || []).filter((c) => c && c.isActive !== false); renderCards(); })
      .catch(() => { cards = []; renderCards(); });
  }
  function renderCards() {
    if (!cards.length) { savedCardsEl.hidden = true; savedCardsEl.innerHTML = ""; paymentMethodId = null; return; }
    if (paymentMethodId && !cards.some((c) => c.id === paymentMethodId)) paymentMethodId = null;
    savedCardsEl.hidden = false;
    savedCardsEl.innerHTML =
      cards.map((c) =>
        '<button class="toggle' + (paymentMethodId === c.id ? " active" : "") + '" type="button" data-card-id="' + escAttr(c.id) + '">' +
          "•••• " + escText(c.last4 || "") + (c.brand ? " · " + escText(c.brand) : "") + (c.isDefault ? " (varsayılan)" : "") +
        "</button>"
      ).join("") +
      '<button class="toggle' + (!paymentMethodId ? " active" : "") + '" type="button" data-card-id="">yeni kart</button>';
    savedCardsEl.querySelectorAll("[data-card-id]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (checkoutState.awaiting || checkoutState.paid) return;
        paymentMethodId = btn.getAttribute("data-card-id") || null;
        renderCards();
      });
    });
  }
  // Ödeme ekranı: redirectUrl/token → iFrame (PayTR iframeResizer varsa yükseklik kendiliğinden), checkoutFormContent → HTML gömülür.
  function showPaymentFrame(payment) {
    payment = payment || {};
    paymentFrameEl.classList.remove("is-empty");
    paymentFrameEl.innerHTML = "";
    const url = payment.redirectUrl || (payment.token ? "https://www.paytr.com/odeme/guvenli/" + encodeURIComponent(payment.token) : null);
    if (url) {
      const frame = document.createElement("iframe");
      frame.id = "paytriframe";
      frame.src = url;
      frame.setAttribute("frameborder", "0");
      frame.setAttribute("scrolling", "no");
      frame.setAttribute("title", "Güvenli ödeme");
      paymentFrameEl.appendChild(frame);
      loadIframeResizer();
    } else if (payment.checkoutFormContent) {
      injectHtml(paymentFrameEl, payment.checkoutFormContent);
      loadIframeResizer();
    } else {
      paymentFrameEl.innerHTML = '<p class="checkout-payment-test">Ödeme onayı bekleniyor…</p>';
    }
  }
  function showPaymentTestNote(text) {
    paymentFrameEl.classList.remove("is-empty");
    paymentFrameEl.innerHTML = '<p class="checkout-payment-test">' + escText(text) + "</p>";
  }
  function resetPaymentFrame() {
    paymentFrameEl.classList.add("is-empty");
    paymentFrameEl.textContent = PAYMENT_FRAME_EMPTY_TEXT;
  }
  // innerHTML script çalıştırmaz — sağlayıcı içeriği script içeriyorsa yeniden oluşturulur.
  function injectHtml(container, html) {
    container.innerHTML = html;
    container.querySelectorAll("script").forEach((old) => {
      const s = document.createElement("script");
      Array.from(old.attributes).forEach((a) => s.setAttribute(a.name, a.value));
      s.text = old.text;
      old.parentNode.replaceChild(s, old);
    });
  }
  // PayTR iFrame yükseklik eşleyici (resmî script) — yüklenemezse CSS min-height ile kalır.
  function loadIframeResizer() {
    function apply() { try { if (window.iFrameResize) window.iFrameResize({}, "#paytriframe"); } catch (e) { /* yok say */ } }
    if (window.iFrameResize) { apply(); return; }
    if (document.getElementById("paytr-iframe-resizer")) return;
    const s = document.createElement("script");
    s.id = "paytr-iframe-resizer";
    s.src = "https://www.paytr.com/js/iframeResizer.min.js";
    s.onload = apply;
    document.head.appendChild(s);
  }

  // ---- Section headers: a left-side circle fills in green once that
  // section's own data is complete; a right-side arrow lets the visitor
  // open/close any section by hand. Müşteri auto-collapses the moment it's
  // first complete (freeing up room for Teslimat/Ödeme) — Teslimat and
  // Ödeme never auto-collapse, only the arrow touches them. ----
  const sectionState = {
    customer: { collapsed: false, manual: false },
    delivery: { collapsed: false, manual: false },
    payment: { collapsed: false, manual: false },
  };
  const sectionEls = {
    customer: { section: customerSection, form: customerForm, check: document.getElementById("customerCheck"), toggle: document.getElementById("customerToggle") },
    delivery: { section: deliverySection, form: deliveryForm, check: document.getElementById("deliveryCheck"), toggle: document.getElementById("deliveryToggle") },
    payment: { section: paymentSection, form: paymentForm, check: document.getElementById("paymentCheck"), toggle: document.getElementById("paymentToggle") },
  };
  function renderSectionState(key, complete, locked) {
    const state = sectionState[key];
    const els = sectionEls[key];
    const collapsed = locked || state.collapsed;
    els.check.classList.toggle("complete", complete);
    els.section.classList.toggle("locked", collapsed);
    els.form.hidden = collapsed;
    els.toggle.disabled = locked;
    els.toggle.classList.toggle("open", !collapsed);
  }
  function refreshSections() {
    const customerOk = customerComplete();
    const deliveryOk = !!selectedDate;
    const paymentOk = paymentComplete();
    if (!sectionState.customer.manual) sectionState.customer.collapsed = customerOk;
    renderSectionState("customer", customerOk, false);
    renderSectionState("delivery", deliveryOk, !customerOk);
    renderSectionState("payment", paymentOk, !customerOk);
    renderLegal();
    if (typeof refreshSteps === "function") refreshSteps(); // mobil adım sekmeleri
  }
  Object.keys(sectionEls).forEach((key) => {
    sectionEls[key].toggle.addEventListener("click", () => {
      sectionState[key].manual = true;
      sectionState[key].collapsed = !sectionState[key].collapsed;
      refreshSections();
    });
  });

  [custName, custEmail, custPhone, custAddress, custZip].forEach((el) => {
    el.addEventListener("input", () => { addressDirty = true; refreshSections(); });
    el.addEventListener("change", saveCustomerForm); // F6 auth: odak çıkınca sunucuya
  });
  custDistrict.addEventListener("change", () => {
    addressDirty = true;
    saveCustomerForm();
    refreshSections();
    // F8 checkout: ilçe = teslimat bölgesi → tarihler ve kargo yeniden
    selectedDate = null;
    loadDatesForZone();
    requestQuote();
  });
  refreshSections();

  // ---- Delivery day (order-level) — F8 checkout: seçenekler GET /delivery/dates?zone= (DeliveryDate; locked/full olan
  // gün pasif). Gün düğmeleri prototiptekiyle aynı (DELIVERY_DAYS); her gün için o güne ait en yakın açık tarih seçilir,
  // bu haftanın kesimi geçtiyse not sonraki haftayı söyler. Seçim sub.deliveryDay'e de yazılır (kutu yükü) ----
  const deliveryDayToggle = document.getElementById("checkoutDeliveryDay");
  const shippingNoteEl = document.getElementById("checkoutShippingNote");
  const dayNoteEl = document.getElementById("checkoutDayNote");

  function currentZoneSlug() {
    if (custDistrict.value) return BahcedenCart.zoneSlugFor(custDistrict.value);
    const a = BahcedenCart.getAddress();
    if (a && a.zoneSlug) return a.zoneSlug;
    const zones = BahcedenCart.getZones();
    return (zones && zones[0] && zones[0].slug) || "urla";
  }
  function availableDateFor(dayId) {
    return deliveryDates.find((d) => d.day === dayId && !d.locked && !d.full) || null;
  }
  function reconcileSelectedDate() {
    const dayId = selectedDate ? selectedDate.day : BahcedenCart.getSub().deliveryDay;
    selectedDate = dayId ? availableDateFor(dayId) : null;
  }
  function loadDatesForZone() {
    if (!BahcedenCart.isLoggedIn()) return Promise.resolve([]);
    const zone = currentZoneSlug();
    return BahcedenCart.loadDeliveryDates(zone)
      .then((list) => {
        deliveryDatesZone = zone;
        deliveryDatesError = null;
        deliveryDates = (list || []).slice().sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
      })
      .catch((err) => { deliveryDatesZone = zone; deliveryDates = []; deliveryDatesError = err; })
      .then(() => { reconcileSelectedDate(); renderDeliveryDay(); refreshSections(); return deliveryDates; });
  }
  function dateLabel(isoDate) {
    const d = new Date(isoDate + "T00:00:00");
    return isNaN(d.getTime()) ? isoDate : d.toLocaleDateString("tr-TR", { day: "numeric", month: "long" });
  }
  function dayLabel(dayId) {
    const d = DELIVERY_DAYS.find((x) => x.id === dayId);
    return d ? d.label : dayId;
  }
  function renderDeliveryDay() {
    const sub = BahcedenCart.getSub();
    const activeDay = selectedDate ? selectedDate.day : null;
    deliveryDayToggle.innerHTML = DELIVERY_DAYS.map((d) => {
      const available = !!availableDateFor(d.id);
      const isActive = activeDay === d.id;
      return '<button class="toggle' + (isActive ? " active" : "") + '" type="button" data-day="' + d.id + '"' + (available ? "" : " disabled") + ">" + d.label + "</button>";
    }).join("");
    deliveryDayToggle.querySelectorAll(".toggle:not([disabled])").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (checkoutState.awaiting || checkoutState.paid) return;
        const dayId = btn.getAttribute("data-day");
        selectedDate = availableDateFor(dayId);
        BahcedenCart.subSetDeliveryDay(dayId);
        render();
      });
    });
    let note = "";
    if (selectedDate) {
      const firstOfDay = deliveryDates.find((d) => d.day === selectedDate.day);
      note = firstOfDay && firstOfDay !== selectedDate && (firstOfDay.locked || firstOfDay.full)
        ? "Bu haftanın " + dayLabel(selectedDate.day) + " kesimi kapandı — teslimatın " + dateLabel(selectedDate.date) + " " + dayLabel(selectedDate.day) + " günü yapılır."
        : "Teslimat: " + dateLabel(selectedDate.date) + " " + dayLabel(selectedDate.day);
    } else if (BahcedenCart.isLoggedIn()) {
      if (deliveryDatesError) note = "Teslimat günleri yüklenemedi — " + (deliveryDatesError.message || "tekrar dene.");
      else if (deliveryDatesZone && !deliveryDates.some((d) => !d.locked && !d.full)) note = "Bu bölge için şu an açık teslimat günü yok.";
      else if (sub.deliveryDay && deliveryDatesZone) note = "Seçtiğin gün için açık tarih kalmadı — başka bir gün seç.";
    }
    dayNoteEl.hidden = !note;
    dayNoteEl.textContent = note || "";
    const fee = quote ? Number(quote.shippingFee || 0) : null;
    shippingNoteEl.textContent = fee === null ? "" : T("shippingLabel") + ": " + (fee > 0 ? money(fee) + " TL" : T("shippingIncludedLabel"));
  }

  // ---- Yasal onaylar (ADR-0003 istisna 3) — requiresAck belgeler; abonelik sözleşmesi yalnız abonelik kutusu varken ----
  const LEGAL_CONSENT_KIND = { PREINFO: "PREINFO_ACK", DISTANCE_SALES: "CONTRACT_ACK", SUBSCRIPTION_CONTRACT: "SUBSCRIPTION_CONTRACT_ACK" };
  function loadLegal() {
    BahcedenCart.loadLegalRequiresAck()
      .then((docs) => { legalDocs = Array.isArray(docs) ? docs : []; renderLegal(); })
      .catch(() => { legalDocs = []; renderLegal(); });
  }
  function hasSubscriptionBox() {
    const payload = BahcedenCart.buildCheckoutPayload();
    return !!(payload.box && !payload.box.isOneTime);
  }
  function requiredLegalDocs() {
    const subBox = hasSubscriptionBox();
    return legalDocs.filter((d) => LEGAL_CONSENT_KIND[d.kind] && (d.kind !== "SUBSCRIPTION_CONTRACT" || subBox));
  }
  function renderLegal() {
    const docs = requiredLegalDocs();
    const show = docs.length > 0 && BahcedenCart.isLoggedIn() && BahcedenCart.hasCheckoutItems() && !checkoutState.paid;
    legalEl.hidden = !show;
    if (!show) { legalEl.innerHTML = ""; return; }
    const html = docs.map((d) =>
      '<label class="consent-row"><input type="checkbox" data-legal-slug="' + escAttr(d.slug) + '"' + (legalChecked[d.slug] ? " checked" : "") + (checkoutState.awaiting ? " disabled" : "") + ">" +
        '<span><a href="politikalar.html#' + escAttr(d.slug) + '" target="_blank" rel="noopener">' + escText(d.title) + "</a> belgesini okudum ve onaylıyorum.</span></label>"
    ).join("");
    if (legalEl.getAttribute("data-rendered") === html) return;
    legalEl.innerHTML = html;
    legalEl.setAttribute("data-rendered", html);
    legalEl.querySelectorAll("input[data-legal-slug]").forEach((cb) => {
      cb.addEventListener("change", () => { legalChecked[cb.getAttribute("data-legal-slug")] = cb.checked; });
    });
  }
  function legalConsents() {
    return requiredLegalDocs().map((d) => ({ kind: LEGAL_CONSENT_KIND[d.kind], documentSlug: d.slug, version: d.version }));
  }
  function legalMissing() {
    return requiredLegalDocs().filter((d) => !legalChecked[d.slug]);
  }

  // ---- Fiyat özeti — F8 checkout: POST /checkout/quote (istemci hesaplamaz) ----
  function quoteExtra() {
    const extra = { zoneSlug: currentZoneSlug() };
    if (couponCode) extra.couponCode = couponCode;
    const sub = BahcedenCart.getSub();
    if (sub.active && !sub.purchased && sub.skipThisWeek) extra.skipThisWeek = true;
    return extra;
  }
  function quoteKey() {
    return JSON.stringify([BahcedenCart.buildCheckoutPayload(), quoteExtra()]);
  }
  function requestQuote(immediate) {
    clearTimeout(quoteTimer);
    const run = () => {
      const key = quoteKey();
      if (!BahcedenCart.hasCheckoutItems()) { quote = null; quoteError = null; lastQuoteKey = key; renderSummary(); return; }
      const seq = ++quoteSeq;
      lastQuoteKey = key;
      BahcedenCart.quoteCheckout(quoteExtra()).then(
        (q) => { if (seq !== quoteSeq) return; quote = q || null; quoteError = null; render(); },
        (err) => { if (seq !== quoteSeq) return; quoteError = err; renderSummary(); },
      );
    };
    if (immediate) run(); else quoteTimer = setTimeout(run, 250);
  }
  // Teklif satırı eşleme: satır tutarları API'den; eşleşmezse "…" (hesap istemcide yapılmaz).
  function quoteLines(kind) {
    return quote && Array.isArray(quote.lines) ? quote.lines.filter((l) => l.kind === kind) : [];
  }
  function boxLineTotal() {
    if (!quote) return null;
    const lines = quoteLines("BOX").concat(quoteLines("EXTRA"));
    if (!lines.length) return null;
    return lines.reduce((sum, l) => sum + Number(l.lineTotal || 0), 0);
  }
  function productLineTotal(item, p, used) {
    if (!quote) return null;
    const candidates = quoteLines("PRODUCT").filter((l) => used.indexOf(l) === -1);
    const byRef = candidates.filter((l) => l.productId === item.id || l.productId === p.id || l.name === p.name || l.productSlug === item.id);
    const exact = byRef.find((l) => Number(l.qty) === Number(item.qty) && (l.pref || null) === (item.pref || null)) || byRef[0];
    if (!exact) return null;
    used.push(exact);
    return Number(exact.lineTotal || 0);
  }
  function fmtMaybe(n) { return n === null || n === undefined ? "…" : money(n) + " TL"; }

  // ---- Complete checkout — F8 checkout: POST /checkout → PayTR iFrame (ya da saklı kart / manuel sağlayıcı) →
  // GET /orders/:orderNo/status (2 s, 120 s) → teşekkür görünümü ----
  const checkoutCompleteBtn = document.getElementById("checkoutComplete");
  const checkoutSuccessEl = document.getElementById("checkoutSuccess");
  function stopPolling() { if (poller && poller.stop) poller.stop(); poller = null; }
  function setBusy(on) {
    checkoutState.busy = on;
    checkoutCompleteBtn.disabled = on || checkoutState.awaiting;
  }
  function validateCheckout() {
    const requiredEls = document.querySelectorAll(".checkout-left [required]");
    let valid = true;
    requiredEls.forEach((el) => {
      const filled = !!el.value && el.value.trim() !== "";
      el.classList.toggle("invalid", !filled);
      if (!filled) valid = false;
    });
    if (!valid) return T("customerRequiredError");
    if (!BahcedenCart.hasCheckoutItems()) return T("cartEmptyError");
    if (!selectedDate || !selectedDate.date) return selectedDate ? T("deliveryDateError") : T("deliveryDayRequiredError");
    const missing = legalMissing();
    if (missing.length) return missing.length === 1 ? fill(T("legalSingleRequiredError"), { belge: missing[0].title }) : T("legalRequiredError");
    if (quoteError && !quote) return T("quoteError");
    return null;
  }
  checkoutCompleteBtn.addEventListener("click", () => {
    if (checkoutState.busy || checkoutState.awaiting || checkoutState.paid) return;
    const problem = validateCheckout();
    if (problem) { showMsg(checkoutMsgEl, problem); return; }
    showMsg(checkoutMsgEl, "");
    showMsg(paymentMsgEl, "");
    setBusy(true);
    const fields = { consents: legalConsents() };
    if (couponCode) fields.couponCode = couponCode;
    if (paymentMethodId) fields.paymentMethodId = paymentMethodId;
    ensureAddressSaved()
      .then((addressId) => {
        fields.addressId = addressId;
        // Teslimat günü: GET /delivery/dates öğesinde id yok → checkout `deliveryOn` (YYYY-MM-DD, adres bölgesi) kabul eder; id varsa o da gider.
        if (selectedDate.id) fields.deliveryDateId = selectedDate.id; else fields.deliveryOn = selectedDate.date;
        return BahcedenCart.submitCheckout(fields);
      })
      .then((res) => { setBusy(false); handleCheckoutResponse(res); })
      .catch((err) => {
        setBusy(false);
        const code = err && err.code;
        let text = (err && err.message) || T("orderError");
        if (code === "DAY_FULL" || code === "DAY_LOCKED") { text = "Seçtiğin teslimat günü doldu ya da kesimi geçti — başka bir gün seç."; selectedDate = null; loadDatesForZone(); }
        else if (code === "SUBSCRIPTION_EXISTS" || code === "ACTIVE_SUBSCRIPTION_EXISTS") text = "Zaten aktif bir aboneliğin var — kutuyu sepetten kaldırıp yalnızca tekil ürünleri sipariş edebilirsin.";
        else if (code === "CONSENT_REQUIRED" || code === "ACK_REQUIRED") text = T("legalRequiredError");
        else if (code === "COUPON_INVALID") text = "Kupon kodu geçersiz — kaldırıp tekrar dene.";
        showMsg(checkoutMsgEl, text);
      });
  });
  function handleCheckoutResponse(res) {
    if (!res || !res.orderNo) { showMsg(checkoutMsgEl, T("orderResponseError")); return; }
    checkoutState.orderNo = res.orderNo;
    // Sağlayıcı adı `payment.providerName` ("manual" | "paytr"); `payment.provider` enum'dur (MANUAL/PAYTR) → küçük harfe indirgenir.
    checkoutState.provider = res.payment ? String(res.payment.providerName || res.payment.provider || "").toLowerCase() || null : null;
    checkoutState.subscription = hasSubscriptionBox();
    if (res.status === "PAID") { onPaid(res.orderNo); return; }
    if (res.status === "PAYMENT_FAILED" || res.status === "CANCELLED") { onPaymentFailed(); return; }
    checkoutState.awaiting = true;
    checkoutCompleteBtn.disabled = true;
    // Ödeme adımı açık olsun (akordiyon kapalıysa aç; mobilde ödeme sekmesine geç).
    sectionState.payment.manual = true; sectionState.payment.collapsed = false;
    refreshSections();
    if (typeof showStep === "function" && isMobileSteps()) showStep("payment");
    if (checkoutState.provider === "manual") {
      showPaymentTestNote("Test ödeme onaylandı — siparişin işleniyor…");
    } else {
      showPaymentFrame(res.payment);
      showMsg(paymentMsgEl, T("paymentPendingNote"), true);
    }
    startPolling(res.orderNo);
  }
  function startPolling(orderNo) {
    stopPolling();
    poller = BahcedenCart.pollOrderStatus(orderNo, { intervalMs: 2000, timeoutMs: 120000 });
    poller.then((r) => {
      if (!checkoutState.awaiting && !returnInfo) return;
      if (r.ok) { onPaid(orderNo, r.status); return; }
      if (r.timedOut) {
        stopAwaiting();
        showMsg(paymentMsgEl, T("paymentTimeoutNote"));
        return;
      }
      if (r.error) {
        stopAwaiting();
        showMsg(paymentMsgEl, r.error.status === 404 ? T("orderNotFoundError") : (r.error.message || "Ödeme durumu alınamadı."));
        return;
      }
      onPaymentFailed();
    });
  }
  // Bekleme bitti ama sonuç yok (zaman aşımı / hata): formlar geri gelir, "doğrulanıyor" görünümü kapanır; iFrame yerinde kalır.
  function stopAwaiting() {
    checkoutState.awaiting = false;
    checkoutCompleteBtn.disabled = false;
    if (document.body.classList.contains("order-done") && !checkoutState.paid) {
      document.body.classList.remove("order-done");
      checkoutSuccessEl.hidden = true;
      checkoutCompleteBtn.hidden = false;
      sectionState.payment.manual = true; sectionState.payment.collapsed = false;
      refreshSections();
    }
  }
  function onPaymentFailed() {
    stopPolling();
    checkoutState.awaiting = false;
    checkoutCompleteBtn.disabled = false;
    document.body.classList.remove("order-done");
    checkoutSuccessEl.hidden = true;
    checkoutCompleteBtn.hidden = false;
    resetPaymentFrame();
    showMsg(paymentMsgEl, T("paymentFailedNote"));
    refreshSections();
  }
  function onPaid(orderNo, statusInfo) {
    stopPolling();
    checkoutState.awaiting = false;
    checkoutState.paid = true;
    const isSubscription = checkoutState.subscription || !!(statusInfo && (statusInfo.subscriptionId || statusInfo.subscriptionStatus));
    // Ödeme tamam: sepet boşalır; kutu taslağı (bahceden_sub) temizlenir — artık sunucudaki abonelik/siparişte yaşar.
    BahcedenCart.setCart([]);
    BahcedenCart.clearSubDraft();
    // Abonelikli kutu ödemesinde üyelik yönlendirmesi eklenir; yalnızca
    // tekli ürün siparişinde kısa teşekkür yeter.
    // F9 CMS: teşekkür metni sepet.texts'ten ({no} sipariş numarasıyla dolar); manuel sağlayıcıda test notu önüne eklenir.
    const prefix = checkoutState.provider === "manual" ? MANUAL_PAYMENT_PREFIX : "";
    checkoutSuccessEl.innerHTML = prefix + fill(T(isSubscription ? "successSubscription" : "successOrder"), { no: escText(orderNo) });
    checkoutCompleteBtn.hidden = true;
    checkoutSuccessEl.hidden = false;
    showMsg(checkoutMsgEl, "");
    showMsg(paymentMsgEl, "");
    legalEl.hidden = true;
    // Ödeme alındı: formlar ve adım sekmeleri kapanır, yalnızca teşekkür
    // mesajı kalır (mobilde ödeme ekranı ekranda durmasın).
    document.body.classList.add("order-done");
    if (stepsEl) stepsEl.hidden = true;
    stripReturnQuery();
    BahcedenCart.loadSubscription().catch(() => null);
  }

  // ---- ?siparis=<no>&odeme=ok|hata — PayTR merchant_ok_url / merchant_fail_url dönüşü (yanıt no-store) ----
  const returnInfo = (function () {
    try {
      const qs = new URLSearchParams(window.location.search);
      const no = qs.get("siparis");
      if (!no) return null;
      return { orderNo: no, result: qs.get("odeme") || "" };
    } catch (e) { return null; }
  })();
  function stripReturnQuery() {
    try {
      const qs = new URLSearchParams(window.location.search);
      if (!qs.has("siparis") && !qs.has("odeme")) return;
      qs.delete("siparis"); qs.delete("odeme");
      const rest = qs.toString();
      history.replaceState(null, "", window.location.pathname + (rest ? "?" + rest : "") + window.location.hash);
    } catch (e) { /* yok say */ }
  }
  let returnHandled = false;
  function handleReturnFromPayment() {
    if (!returnInfo || returnHandled || !BahcedenCart.isLoggedIn()) return;
    returnHandled = true;
    checkoutState.orderNo = returnInfo.orderNo;
    if (returnInfo.result === "hata") {
      showMsg(paymentMsgEl, T("paymentFailedNote"));
      sectionState.payment.manual = true; sectionState.payment.collapsed = false;
      refreshSections();
      stripReturnQuery();
      return;
    }
    // ok: callback sunucuya birkaç saniye sonra düşebilir — doğrulanana kadar bekle.
    checkoutState.awaiting = true;
    checkoutCompleteBtn.hidden = true;
    checkoutSuccessEl.textContent = T("paymentVerifyingNote");
    checkoutSuccessEl.hidden = false;
    document.body.classList.add("order-done");
    if (stepsEl) stepsEl.hidden = true;
    startPolling(returnInfo.orderNo);
  }
  // Ödeme dönüşü iFrame içinde kaldıysa (üst pencereye çıkamadı) sayfayı sonuca taşı.
  window.addEventListener("message", (e) => {
    if (e.origin !== window.location.origin || !e.data || typeof e.data !== "object" || typeof e.data.bagdamCheckout !== "string") return;
    if (!/^\?/.test(e.data.bagdamCheckout)) return;
    window.location.href = window.location.pathname + e.data.bagdamCheckout;
  });
  // Giriş yapılmadan dönüldüyse (çerez yok): giriş kutusuna kısa not; giriş sonrası sayfa yenilenir, ?siparis korunur.
  if (returnInfo && !BahcedenCart.isLoggedIn()) {
    const loginMsg = document.getElementById("loginMsg");
    if (loginMsg) { loginMsg.textContent = "Ödeme sonucunu görmek için giriş yap."; loginMsg.hidden = false; }
  }

  // "Bu haftaki kutuma ekle" az önce kullanıldıysa, boşalan sepette bunun
  // onay notunu gösterebilmek için akılda tutulur (sayfa görünümü boyunca).
  let justAddedToBox = false;
  let mergeError = "";

  function renderSummary() {
    // Yalnız toplam bloğunu tazelemek yerine özet baştan çizilir (satır tutarları da teklife bağlı).
    render(true);
  }

  function render(skipQuote) {
    const items = BahcedenCart.getCart();
    const sub = BahcedenCart.getSub();
    const tier = sub.active ? BahcedenCart.subTier() : null;
    const wrap = document.getElementById("cartWrap");
    BahcedenCart.renderCategoryPile(document.getElementById("shopHeroFillRow"));

    if (!tier && items.length === 0) {
      wrap.innerHTML = BahcedenCart.hasPurchasedSub()
        ? '<h2 class="checkout-section-title">' + escText(T("summaryTitle")) + "</h2>" +
          (justAddedToBox
            ? '<p class="checkout-shipping-note mono">Ürünler bu haftaki kutuna eklendi — ödemesi kutu ücretiyle birlikte çekilecek, kutunla aynı gün teslim edilecek.</p>'
            : '<p class="cart-empty mono">' + escText(T("emptyCart")) + "</p>") +
          '<a class="btn" href="uyelik.html">aboneliğini görüntüle</a>'
        : '<p class="cart-empty mono">henüz bir aboneliğin yok.</p>' +
          '<a class="btn" href="urunler.html">aboneliği başlat</a>';
      quote = null;
      renderDeliveryDay();
      refreshSections();
      return;
    }

    let subBlock = "";
    const usedLines = [];
    if (tier) {
      const isSub = sub.type === "subscription";
      const extras = sub.extras || [];
      const lineTotal = sub.skipThisWeek ? 0 : boxLineTotal();
      const itemNames = sub.items
        .map((id) => { const p = PRODUCTS.find((x) => x.id === id); return p ? p.name : ""; })
        .filter(Boolean)
        .join(", ");
      const extrasNames = extras
        .map((ex) => { const p = PRODUCTS.find((x) => x.id === ex.id); return p ? p.name + " (" + ex.label + ")" : ""; })
        .filter(Boolean)
        .join(", ");
      const freq = FREQ_OPTIONS.find((f) => f.id === sub.freq);
      const freqLabel = freq ? freq.label + (!freq.allDays && sub.deliveryDay ? " — " + (DELIVERY_DAYS.find((d) => d.id === sub.deliveryDay) || {}).label : "") : "";
      const noteHtml = isSub
        ? (sub.skipThisWeek
            ? '<p class="sub-skip-note mono">BU HAFTA ATLANDI</p>'
            : '<p class="sub-skip-note mono">' + freqLabel.toLocaleUpperCase("tr-TR") + " OTOMATİK GELİR</p>")
        : "";
      const controlsHtml =
        '<div class="qty-row">' +
          '<a class="cart-remove mono" href="kutu.html?tier=' + tier.id + '">kutuyu düzenle</a>' +
          '<button class="cart-remove mono" id="subRemove" type="button">kaldır</button>' +
        "</div>";
      subBlock =
        '<div class="cart-row sub-row">' +
          '<img src="' + tier.img + '" alt="' + tier.label + '">' +
          '<div class="cart-row-info">' +
            "<h3>" + tier.label + " — " + tier.count + " ürün" + (extras.length ? " + " + extras.length + " ekstra" : "") + "</h3>" +
            '<p class="pcard-meta mono">' + itemNames + "</p>" +
            (extrasNames ? '<p class="pcard-meta mono">+ EKSTRA: ' + extrasNames + "</p>" : "") +
            noteHtml +
            controlsHtml +
          "</div>" +
          '<span class="price mono">' + fmtMaybe(lineTotal) + "</span>" +
        "</div>";
    }

    const TRASH_SVG =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';

    const rows = items
      .map((item, i) => {
        const p = PRODUCTS.find((x) => x.id === item.id);
        if (!p) return "";
        const lineTotal = productLineTotal(item, p, usedLines);
        const isTrash = item.qty === 1;
        return (
          '<div class="cart-row">' +
            '<img src="' + p.img + '" alt="' + p.name + '">' +
            '<div class="cart-row-info">' +
              "<h3>" + p.name + "</h3>" +
              '<p class="pcard-meta mono">' + (item.pref ? item.pref : p.meta) + "</p>" +
              '<div class="qty-stepper-row">' +
                '<button class="qty-stepper-dec' + (isTrash ? " trash" : "") + '" data-idx="' + i + '" data-dir="-1" type="button" aria-label="' + (isTrash ? "Sepetten kaldır" : "Azalt") + '">' +
                  (isTrash ? TRASH_SVG : "−") +
                "</button>" +
                '<span class="qty-stepper-count mono">' + item.qty + "</span>" +
                '<button class="qty-stepper-inc" data-idx="' + i + '" data-dir="1" type="button" aria-label="Arttır">+</button>' +
              "</div>" +
            "</div>" +
            '<span class="price mono">' + fmtMaybe(lineTotal) + "</span>" +
          "</div>"
        );
      })
      .join("");

    // Aktif (satın alınmış) aboneliği olan biri tekli ürün eklediyse iki yol
    // sunulur: normal akışla hemen ödemek, ya da ürünleri bu haftaki kutuya
    // taşımak — o zaman ücreti kutu ödemesiyle aynı gün çekilir ve kutuyla
    // aynı gün teslim edilir. (F8 checkout: POST /me/subscription/cycles/current/merge-cart)
    const addToBoxHtml = BahcedenCart.hasPurchasedSub() && items.length > 0
      ? '<div class="addon-choice">' +
          '<p><b>Aktif aboneliğin var.</b> Bu ürünleri hemen ödemek için aşağıdaki sipariş adımlarını tamamla — ayrı bir sipariş olarak işlenir, teslimat gününü seçersin. İstersen bu haftaki kutuna ekle: ücreti kutu ödemenle aynı gün çekilir, kutunla aynı gün teslim edilir.</p>' +
          '<button class="btn" id="addToBoxBtn" type="button">' + escText(T("addToBoxCta")) + "</button>" +
          (mergeError ? '<p class="checkout-auth-msg mono">' + escText(mergeError) + "</p>" : "") +
        "</div>"
      : "";

    // F8 checkout: toplamlar teklife göre (POST /checkout/quote) — istemci hesap yapmaz. Kupon alanı (ADR-0003 istisna 8 adayı).
    const vatRate = quote && quote.lines && quote.lines.length ? quote.lines[0].vatRate : null;
    const vatTotal = quote ? Number(quote.vatTotal || 0) : null;
    const shippingFee = quote ? Number(quote.shippingFee || 0) : null;
    const grandTotal = quote ? Number(quote.grandTotal || 0) : null;
    const discountTotal = quote ? Number(quote.discountTotal || 0) : 0;
    const couponStatus = quote && quote.couponStatus ? quote.couponStatus : null;
    const couponDiscount = couponStatus && couponStatus.valid ? Number(couponStatus.discount || 0) : 0;
    const otherDiscount = Math.max(0, discountTotal - couponDiscount);
    const discountNote = quote && Array.isArray(quote.notes)
      ? quote.notes.find((n) => n && (n.code === "FIRST_BOXES_DISCOUNT" || n.code === "RETENTION_DISCOUNT"))
      : null;
    const vatLines = vatTotal !== null && vatTotal > 0
      ? '<div class="cart-vat-row"><span>' + (vatRate !== null && vatRate !== undefined ? "%" + money(vatRate) + " " : "") + 'KDV</span><span class="mono">' + money(vatTotal) + " TL</span></div>"
      : "";
    const discountLines =
      (couponDiscount > 0 ? '<div class="cart-vat-row"><span>Kupon ' + escText(couponCode) + '</span><span class="mono">−' + money(couponDiscount) + " TL</span></div>" : "") +
      (otherDiscount > 0 ? '<div class="cart-vat-row"><span>' + escText(discountNote && discountNote.message ? discountNote.message : "İndirim") + '</span><span class="mono">−' + money(otherDiscount) + " TL</span></div>" : "");
    // Teklif alınamadı (ağ/sunucu): teknik zarf mesajı yerine sabit Türkçe not + yeniden dene (tutar istemcide hesaplanmaz).
    const errorLine = quoteError && !quote
      ? '<div class="cart-vat-row"><span>' + escText(quoteError.status === 0 ? quoteError.message : "Tutar şu an hesaplanamıyor.") + '</span><span class="mono"><a href="#" id="quoteRetry">tekrar dene</a></span></div>'
      : "";
    const couponMsg = couponStatus && couponStatus.message
      ? '<p class="checkout-auth-msg mono coupon-msg' + (couponStatus.valid ? " ok" : "") + '" id="couponMsg">' + escText(couponStatus.message) + "</p>"
      : '<p class="checkout-auth-msg mono coupon-msg" id="couponMsg" hidden></p>';
    const couponHtml =
      '<div class="checkout-form coupon-row" id="couponRow">' +
        '<label>Kupon kodu<span class="coupon-field"><input type="text" id="couponInput" placeholder="KOD" autocomplete="off" value="' + escAttr(couponCode) + '">' +
        '<button class="btn" type="button" id="couponApply">' + (couponCode ? "kaldır" : "uygula") + "</button></span></label>" +
        couponMsg +
      "</div>";

    wrap.innerHTML =
      '<h2 class="checkout-section-title">' + escText(T("summaryTitle")) + "</h2>" +
      '<div class="cart-rows">' + subBlock + rows + "</div>" +
      addToBoxHtml +
      couponHtml +
      '<div class="cart-summary">' +
        '<div class="cart-total"><span>Toplam</span><span class="mono">' + fmtMaybe(grandTotal) + "</span></div>" +
        '<div class="cart-vat-row"><span>' + escText(T("shippingLabel")) + '</span><span class="mono">' + (shippingFee === null ? "…" : (shippingFee > 0 ? money(shippingFee) + " TL" : escText(T("shippingIncludedLabel")))) + "</span></div>" +
        discountLines +
        vatLines +
        errorLine +
      "</div>" +
      // Mobil adım akışı: özetten sonraki adıma geçiş (masaüstünde gizli).
      '<button class="cta wide summary-continue" id="summaryContinue" type="button" hidden>devam et</button>';

    const summaryContinue = document.getElementById("summaryContinue");
    if (summaryContinue) summaryContinue.addEventListener("click", () => showStep("customer"));
    const addToBoxBtn = document.getElementById("addToBoxBtn");
    if (addToBoxBtn) {
      addToBoxBtn.addEventListener("click", () => {
        addToBoxBtn.disabled = true;
        mergeError = "";
        BahcedenCart.mergeCartIntoBox()
          .then(() => { justAddedToBox = true; render(); })
          .catch((err) => { mergeError = (err && err.message) || "Kutuya eklenemedi — tekrar dene."; render(); });
      });
    }
    const couponInput = document.getElementById("couponInput");
    const couponApply = document.getElementById("couponApply");
    function applyCoupon() {
      const next = couponCode ? "" : couponInput.value.trim().toLocaleUpperCase("tr-TR");
      couponCode = next;
      render();
      requestQuote(true);
    }
    if (couponApply) couponApply.addEventListener("click", applyCoupon);
    if (couponInput) couponInput.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); applyCoupon(); } });
    const quoteRetry = document.getElementById("quoteRetry");
    if (quoteRetry) quoteRetry.addEventListener("click", (e) => { e.preventDefault(); lastQuoteKey = null; requestQuote(true); });

    const subRemove = document.getElementById("subRemove");
    if (subRemove) {
      subRemove.addEventListener("click", () => {
        // Just un-commits it from the cart (active:false) — keeps the box's
        // tier/items/frequency so it's still there if they come back to it.
        const s = BahcedenCart.getSub();
        s.active = false;
        BahcedenCart.setSub(s);
        render();
      });
    }

    wrap.querySelectorAll(".qty-stepper-dec[data-idx], .qty-stepper-inc[data-idx]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.getAttribute("data-idx"), 10);
        const dir = parseInt(btn.getAttribute("data-dir"), 10);
        const items = BahcedenCart.getCart();
        BahcedenCart.setQty(idx, items[idx].qty + dir);
        render();
      });
    });

    renderDeliveryDay();
    refreshSections();
    // Sepet/bölge/kupon değiştiyse teklif yenilenir (aynıysa istek yok).
    if (!skipQuote && quoteKey() !== lastQuoteKey) requestQuote();
  }

  // ---- Mobil adım sekmeleri (≤640px). Masaüstünde çubuk gizli; bölümler
  // eski akordiyon davranışında kalır. Kilit kuralı aynı: müşteri bilgileri
  // tamamlanmadan teslimat/ödeme açılmaz. Bir adım tamamlanınca sonrakine
  // kendiliğinden geçer. Özet sekmesinde "devam et" — "bu haftaki kutuma
  // ekle" kullanıldıysa (sepet boşalır, kutuya eklenir) devam çıkmaz.
  stepsEl = document.getElementById("checkoutSteps");
  stepBtns = stepsEl.querySelectorAll(".checkout-step");
  stepPanels = {
    summary: document.querySelector(".checkout-right"),
    customer: customerSection,
    delivery: deliverySection,
    payment: paymentSection,
  };
  let currentStep = "summary";
  let lastAuto = { customer: false, delivery: false };
  function isMobileSteps() { return window.innerWidth <= 900; }
  function stepUnlocked(key) {
    if (key === "summary") return true;
    const hasItems = BahcedenCart.getCart().length > 0 || BahcedenCart.getSub().active;
    if (key === "customer") return hasItems;
    return hasItems && customerComplete(); // delivery & payment
  }
  function showStep(key) {
    if (!stepUnlocked(key)) return;
    currentStep = key;
    stepBtns.forEach((b) => b.classList.toggle("active", b.getAttribute("data-step") === key));
    Object.keys(stepPanels).forEach((k) => stepPanels[k].classList.toggle("step-hidden", isMobileSteps() && k !== key));
    // Sekmede gösterilen bölüm açık olsun (akordiyonun gizlediği formu aç).
    if (isMobileSteps() && sectionState[key]) { sectionState[key].manual = true; sectionState[key].collapsed = false; refreshSections(); }
    if (isMobileSteps()) window.scrollTo({ top: Math.max(0, stepsEl.getBoundingClientRect().top + window.scrollY - 70), behavior: "smooth" });
  }
  function refreshSteps() {
    if (!stepsEl) return; // kurulumdan önce çağrılırsa
    const loggedIn = BahcedenCart.isLoggedIn();
    // Sepet boşken (ürün/kutu yok) sekme çubuğu anlamsız — gizli. Ödeme alındıysa da gizli.
    stepsEl.hidden = !(loggedIn && isMobileSteps() && stepUnlocked("customer")) || checkoutState.paid;
    stepBtns.forEach((b) => {
      const k = b.getAttribute("data-step");
      b.disabled = !stepUnlocked(k);
      const done = (k === "customer" && customerComplete()) || (k === "delivery" && !!selectedDate) || (k === "payment" && paymentComplete());
      b.classList.toggle("done", done);
    });
    // Otomatik ilerleme: müşteri tamamlandı → teslimat; teslimat günü seçildi → ödeme.
    if (isMobileSteps() && loggedIn) {
      if (currentStep === "customer" && customerComplete() && !lastAuto.customer) { lastAuto.customer = true; showStep("delivery"); }
      else if (currentStep === "delivery" && selectedDate && !lastAuto.delivery) { lastAuto.delivery = true; showStep("payment"); }
      else if (!stepUnlocked(currentStep)) showStep("summary");
      else Object.keys(stepPanels).forEach((k) => stepPanels[k].classList.toggle("step-hidden", k !== currentStep));
    } else {
      Object.keys(stepPanels).forEach((k) => stepPanels[k].classList.remove("step-hidden"));
    }
    // Özet altındaki "devam et": yalnızca mobil + giriş + sepette ürün/kutu var.
    const contBtn = document.getElementById("summaryContinue");
    if (contBtn) contBtn.hidden = !(isMobileSteps() && loggedIn && stepUnlocked("customer"));
  }
  stepsEl.addEventListener("click", (e) => {
    const b = e.target.closest(".checkout-step");
    if (!b || b.disabled) return;
    showStep(b.getAttribute("data-step"));
  });
  // Müşteri alanları her değiştiğinde ve teslimat günü seçildiğinde kilitler güncellensin.
  [custName, custEmail, custPhone, custAddress, custZip, custDistrict].forEach((el) => el.addEventListener("input", refreshSteps));
  custDistrict.addEventListener("change", refreshSteps);
  window.addEventListener("resize", refreshSteps);

  refreshAuthGate();
  render();
  refreshSteps();
  if (BahcedenCart.isLoggedIn()) loadProfileIntoForms(); // F6 auth: adres/e-posta sunucudan (+ F8 checkout verileri)
})();
</script>

</body>
</html>
