<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bağdam — toptan</title>
<link rel="icon" type="image/svg+xml" href="assets/logo/logo-icon.svg">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <button class="nav-burger" type="button" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
      <img class="nav-burger-closed" src="assets/icons/hamburger-kapali.png" alt="">
      <img class="nav-burger-open" src="assets/icons/hamburger-acik.png" alt="">
    </button>
    <a class="wordmark" href="index.html"><img src="assets/logo/logo-horizontal.svg" alt="Bağdam"></a>
    <nav class="nav-links" id="navLinks">
      <a href="urunler.html">tüm ürünler</a>
      <a href="gunluk.html">blog</a>
      <a href="toptan.html" class="on">toptan</a>
      <a href="nasil-seciyoruz.html">nasıl seçiyoruz</a>
    </nav>
    <div class="nav-icons">
      <a href="uyelik.html" class="nav-icon" aria-label="Üyelik">
        <img src="assets/icons/uye-icon.png" alt="Üyelik">
      </a>
    </div>
  </div>
</header>

<main>
  <section class="soon-hero">
    <img class="soon-icon" src="assets/icons/toptan-icon.png" alt="">
    <span class="eyebrow">{{{site.toptan.hero.eyebrow}}}</span>
    <h1>{{{site.toptan.hero.title}}}</h1>
    <p class="soon-text">{{{site.toptan.hero.text}}}</p>

    <form class="notify-form" id="notifyForm">
      <input type="email" class="notify-input" placeholder="{{{site.toptan.form.emailPlaceholder}}}" required aria-label="E-posta adresin">
      <button class="cta" type="submit">{{{site.toptan.form.submitText}}}</button>
    </form>
    <p class="notify-msg" id="notifyMsg" hidden>{{{site.toptan.form.successMessage}}}</p>
  </section>

  <section class="soon-details">
{{#each site.toptan.details.items}}
    <div class="soon-detail">
      <h3>{{{title}}}</h3>
      <p>{{{text}}}</p>
    </div>
{{/each}}
  </section>
</main>

{{> cookie_consent}}
{{> site_footer}}

{{> bootstrap}}
<script>
(function () {
  // F5: form → POST /api/v1/wholesale-leads (WholesaleModule; 3/dk/IP). Mesaj metinleri SiteContent toptan.form'dan
  // (WebController toptanTextsJson). Başarıda form gizlenir, mevcut #notifyMsg gösterilir; hatada form açık kalır.
  var texts = {{{toptanTextsJson}}};
  var form = document.getElementById("notifyForm");
  var msg = document.getElementById("notifyMsg");
  var input = form.querySelector('input[type="email"]');
  var button = form.querySelector('button[type="submit"]');
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  function showMsg(text, isError) {
    msg.textContent = text;
    msg.classList.toggle("is-error", !!isError);
    msg.hidden = false;
  }
  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var email = (input.value || "").trim();
    if (!EMAIL_RE.test(email)) {
      showMsg(texts.invalid, true);
      input.focus();
      return;
    }
    button.disabled = true;
    // F6: oturumlu müşteride CsrfGuard access çerezini görünce X-CSRF-Token ister → BahcedenCart.api() (çerez + CSRF
    // başlığı; anonimde de çalışır). cart.js yüklenmemişse düz fetch yedeği (anonim — CSRF gerekmez).
    // (cart.js `const BahcedenCart` — window özelliği değil, sözcüksel global: typeof ile yokla)
    var send = (typeof BahcedenCart !== "undefined" && BahcedenCart && typeof BahcedenCart.api === "function")
      ? BahcedenCart.api("/wholesale-leads", { method: "POST", body: { email: email } })
      : fetch("/api/v1/wholesale-leads", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ email: email })
        }).then(function (res) { if (!res.ok) throw new Error("HTTP " + res.status); });
    send
      .then(function () {
        form.hidden = true;
        showMsg(texts.success, false);
      })
      .catch(function () {
        button.disabled = false;
        showMsg(texts.error, true);
      });
  });
})();
</script>
</body>
</html>
